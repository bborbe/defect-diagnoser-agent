me use the function. It shortens the script considerably.\n\nNow let me write out the full script.\n\n```bash\n#!/usr/bin/env bash\n# Clones a public GitHub repository read-only into the fixed repos/ directory.\n\ninvalid() {\n  echo \"invalid repo reference\" >&2\n  exit 2\n}\n\nif [ \"$#\" -ne 2 ]; then\n  echo \"usage: repo-clone.sh clone <owner>/<name>\" >&2\n  exit 2\nfi\n\nif [ \"$1\" != \"clone\" ]; then\n  echo \"usage: repo-clone.sh clone <owner>/<name>\" >&2\n  exit 2\nfi\n\nref=\"$2\"\n\ncase \"$ref\" in\n  https://github.com/*) slug=\"${ref#https://github.com/}\" ;;\n  git@github.com:*) slug=\"${ref#git@github.com:}\" ;;\n  *\"://\"*) invalid ;;\n  *) slug=\"$ref\" ;;\nesac\n\ncase \"$slug\" in\n  *.git) slug=\"${slug%.git}\" ;;\nesac\n\nowner=\"${slug%%/*}\"\nname=\"${slug#*/}\"\n\nif [ \"$name\" = \"$slug\" ] || [ -z \"$owner\" ] || [ -z \"$name\" ]; then\n  invalid\nfi\n\ncase \"$name\" in\n  */*) invalid ;;\nesac\n\ncase \"$owner\" in\n  \".\" | \"..\") invalid ;;\n  *[!A-Za-z0-9._-]*) invalid ;;\nesac\n\ncase \"$name\" in\n  \".\" | \"..\") invalid ;;\n  *[!A-Za-z0-9._-]*) invalid ;;\nesac\n\nscript_dir=\"$(cd \"$(dirname \"$0\")\" && pwd -P)\"\nagent_dir=\"$(cd \"$script_dir/..\" && pwd -P)\"\nrepos_dir=\"$agent_dir/repos\"\n\nif [ -L \"$repos_dir\" ]; then\n  invalid\nfi\n\nif [ -e \"$repos_dir/$owner\" ] || [ -L \"$repos_dir/$owner\" ]; then\n  parent=\"$(cd \"$repos_dir/$owner\" 2>/dev/null && pwd -P)\"\nelse\n  parent=\"$repos_dir/$owner\"\nfi\n\nif [ -z \"$parent\" ]; then\n  invalid\nfi\n\ndest=\"$parent/$name\"\n\nif [ -e \"$dest\" ] || [ -L \"$dest\" ]; then\n  dest_real=\"$(cd \"$dest\" 2>/dev/null && pwd -P)\"\nelse\n  dest_real=\"$dest\"\nfi\n\nif [ -z \"$dest_real\" ]; then\n  invalid\nfi\n\ncase \"$parent\" in\n  \"$repos_dir\"/*) ;;\n  *) invalid ;;\nesac\n\ncase \"$dest_real\" in\n  \"$repos_dir\"/*) ;;\n  *) invalid ;;\nesac\n\nif [ -e \"$dest\" ] || [ -L \"$dest\" ]; then\n  chmod -R u+w \"$dest\" 2>/dev/null\n  rm -rf \"$dest\"\nf