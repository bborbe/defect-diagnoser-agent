ead\").Error(),\n\t}, true\n}\n\n// checkDefectID implements rule g.\nfunc checkDefectID(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tverdict Verdict,\n) (Decision, bool) {\n\tfrontmatterID, ok := md.Frontmatter.String(FieldDefectID)\n\tif ok && frontmatterID == verdict.DefectID {\n\t\treturn Decision{}, false\n\t}\n\tremoveVerdict(md)\n\treturn Decision{\n\t\tStatus: agentlib.AgentStatusNeedsInput,\n\t\tMessage: errors.Errorf(\n\t\t\tctx,\n\t\t\t\"defect_id mismatch: verdict %q, frontmatter %q\",\n\t\t\tverdict.DefectID,\n\t\t\tfrontmatterID,\n\t\t).Error(),\n\t}, true\n}\n\n// checkService implements rule h.\nfunc (g *Gate) checkService(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tverdict Verdict,\n) (Decision, bool) {\n\tif _, ok := g.lookupService(verdict.Service); ok {\n\t\treturn Decision{}, false\n\t}\n\tremoveVerdict(md)\n\treturn Decision{\n\t\tStatus:  agentlib.AgentStatusNeedsInput,\n\t\tMessage: errors.Errorf(ctx, \"service %q does not resolve\", verdict.Service).Error(),\n\t}, true\n}\n\n// checkRepo implements rule i.\nfunc (g *Gate) checkRepo(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tverdict Verdict,\n) (Decision, bool) {\n\tmapped, ok := g.lookupService(verdict.Service)\n\tif !ok || mapped == verdict.Repo {\n\t\treturn Decision{}, false\n\t}\n\tremoveVerdict(md)\n\treturn Decision{\n\t\tStatus: agentlib.AgentStatusNeedsInput,\n\t\tMessage: errors.Errorf(\n\t\t\tctx,\n\t\t\t\"repo %q does not match mapped repo %q\",\n\t\t\tverdict.Repo,\n\t\t\tmapped,\n\t\t).Error(),\n\t}, true\n}\n\n// checkBelowHigh implements rule j.\nfunc (g *Gate) checkBelowHigh(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tverdict Verdict,\n) (Decision, bool) {\n\tif verdict.Confidence != ConfidenceMedium && verdict.Confidence != ConfidenceLow {\n\t\treturn Decision{}, false\n\t}\n\terr := CheckLineGuard(ctx, g.cloneRoot, verdict.Repo, verdict.FileLine)\n\tif err != nil {\n\t\tremoveVerdict(md)\n\t\treturn Decision{\n\t\t\tStatus:  agentlib.AgentStatusNeedsInput,\n\t\t\tMessage: lineGuardMessage(ctx, err, verdict.Evidence),\n\t\t}, true\n\t}\n\treturn Decision{\n\t\tStatus:  agentlib.AgentStatusNeedsInput,\n\t\tMessage: errors.Errorf(ctx, \"confidence %s below High\", verdict.Confidence).Error(),\n\t}, true\n}\n\n// lookupService resolves a service through the operator-supplied mapping. The\n// match is exact and case-sensitive; no fuzzy match, no fallback.\nfunc (g *Gate) lookupService(service string) (string, bool) {\n\trepo, ok := g.envContext[\"service_repo.\"+service]\n\treturn repo, ok\n}\n\n// failed removes the verdict and returns a failed decision.\nfunc failed(ctx context.Context, md *agentlib.Markdown, format string, args ...interface{}) (\n\tDecision, bool,\n) {\n\tremoveVerdict(md)\n\treturn Decision{\n\t\tStatus:  agentlib.AgentStatusFailed,\n\t\tMessage: errors.Errorf(ctx, format, args...).Error(),\n\t}, true\n}\n\n// lineGuardMessage renders a line-guard reason with the evidence quoted raw.\nfunc lineGuardMessage(ctx context.Context, err error, evidence string) string {\n\treturn errors.Errorf(ctx, \"%s; evidence:\\n%s\", err.Error(), evidence).Error()\n}\n\n// removeVerdict removes every \"## Verdict\" section from the parsed sections.\nfunc removeVerdict(md *agentlib.Markdown) {\n\tremoveSection(md, VerdictSectionHeading)\n}\n\n// removeSection filters every section with the given heading out of md.Sections.\nfunc removeSection(md *agentlib.Markdown, heading string) {\n\tkept := md.Sections[:0]\n\tfor _, section := range md.Sections {\n\t\tif section.Heading != heading {\n\t\t\tkept = append(kept, section)\n\t\t}\n\t}\n\tmd.Sections = kept\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b0184a964fcfcd11","type":"tool_result","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage verdict\n\nimport (\n\t\"context\"\n\t\"strings\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/errors\"\n\t\"github.com/bborbe/vault-cli/pkg/domain\"\n)\n\nconst (\n\tplanSection    = \"## Plan\"\n\treviewSection  = \"## Review\"\n\tfailureSection = \"## Failure\"\n)\n\n// PrefixMessage prefixes every line of message with \"> \".\nfunc PrefixMessage(message string) string {\n\tlines := strings.Split(message, \"\\n\")\n\tfor index := range lines {\n\t\tlines[index] = \"> \" + lines[index]\n\t}\n\treturn strings.Join(lines, \"\\n\")\n}\n\n// stepWrapper records its phase on entry, applies the heading rule to the\n// section its inner step wrote, runs the gate where the phase needs it, and\n// prefixes failure messages once on the way out.\ntype stepWrapper struct {\n\tinner    agentlib.Step\n\tphase    domain.TaskPhase\n\tsection  string\n\tgate     *Gate\n\tisReview bool\n}\n\n// NewPlanningStep wraps the planning step. It records phase planning and\n// applies the heading rule to \"## Plan\".\nfunc NewPlanningStep(inner agentlib.Step) agentlib.Step {\n\treturn &stepWrapper{\n\t\tinner:   inner,\n\t\tphase:   domain.TaskPhasePlanning,\n\t\tsection: planSection,\n\t}\n}\n\n// NewExecutionStep wraps the execution step. It records phase execution,\n// applies the heading rule to \"## Verdict\" and evaluates the gate.\nfunc NewExecutionStep(inner agentlib.Step, gate *Gate) agentlib.Step {\n\treturn &stepWrapper{\n\t\tinner:   inner,\n\t\tphase:   domain.TaskPhaseExecution,\n\t\tsection: VerdictSectionHeading,\n\t\tgate:    gate,\n\t}\n}\n\n// NewAIReviewStep wraps the ai_review step. It records phase ai_review,\n// applies the heading rule to \"## Review\", re-runs the gate and then the line\n// guard; on success it removes any stale \"## Failure\" and completes the task.\nfunc NewAIReviewStep(inner agentlib.Step, gate *Gate) agentlib.Step {\n\treturn &stepWrapper{\n\t\tinner:    inner,\n\t\tphase:    domain.TaskPhaseAIReview,\n\t\tsection:  reviewSection,\n\t\tgate:     gate,\n\t\tisReview: true,\n\t}\n}\n\n// Name delegates to the inner step.\nfunc (w *stepWrapper) Name() string { return w.inner.Name() }\n\n// ShouldRun delegates to the inner step.\nfunc (w *stepWrapper) ShouldRun(ctx context.Context, md *agentlib.Markdown) (bool, error) {\n\treturn w.inner.ShouldRun(ctx, md)\n}\n\n// Run implements agentlib.Step.\nfunc (w *stepWrapper) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n\tw.recordPhase(md)\n\tresult, err := w.inner.Run(ctx, md)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"%s run\", w.inner.Name())\n\t}\n\tif result == nil {\n\t\treturn nil, errors.Errorf(ctx, \"%s returned nil result\", w.inner.Name())\n\t}\n\tif result.Status != agentlib.AgentStatusDone {\n\t\tresult.Message = prefixFailureMessage(result.Status, result.Message)\n\t\treturn result, nil\n\t}\n\tif decision, fired := checkHeading(ctx, md, w.section); fired {\n\t\treturn prefixedResult(decision), nil\n\t}\n\treturn w.afterHeading(ctx, md, result), nil\n}\n\n// afterHeading runs the phase-specific logic once the heading rule passed.\nfunc (w *stepWrapper) afterHeading(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tresult *agentlib.Result,\n) *agentlib.Result {\n\tswitch {\n\tcase w.gate == nil:\n\t\treturn result\n\tcase w.isReview:\n\t\tdecision := w.gate.Review(ctx, md)\n\t\tif decision.Status != agentlib.AgentStatusDone {\n\t\t\treturn prefixedResult(decision)\n\t\t}\n\t\tremoveSection(md, failureSection)\n\t\treturn &agentlib.Result{\n\t\t\tStatus:    agentlib.AgentStatusDone,\n\t\t\tNextPhase: string(domain.TaskPhaseDone),\n\t\t}\n\tdefault:\n\t\tdecision := w.gate.Evaluate(ctx, md)\n\t\tif decision.Status != agentlib.AgentStatusDone {\n\t\t\treturn prefixedResult(decision)\n\t\t}\n\t\treturn result\n\t}\n}\n\n// recordPhase stamps the task's phase on entry so an escalation leaves the\n// task on the phase that escalated.\nfunc (w *stepWrapper) recordPhase(md *agentlib.Markdown) {\n\tif md.Frontmatter == nil {\n\t\tmd.Frontmatter = agentlib.TaskFrontmatter{}\n\t}\n\tmd.Frontmatter[\"phase\"] = string(w.phase)\n}\n\n// prefixedResult builds a result from a gate decision with its message\n// prefixed once.\nfunc prefixedResult(decision Decision) *agentlib.Result {\n\treturn &agentlib.Result{\n\t\tStatus:  decision.Status,\n\t\tMessage: prefixFailureMessage(decision.Status, decision.Message),\n\t}\n}\n\n// prefixFailureMessage prefixes the message only for failed/needs_input.\nfunc prefixFailureMessage(status agentlib.AgentStatus, message string) string {\n\tif status == agentlib.AgentStatusFailed || status == agentlib.AgentStatusNeedsInput {\n\t\treturn PrefixMessage(message)\n\t}\n\treturn message\n}\n===LINE GUARD===\n// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage verdict\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/bborbe/errors\"\n)\n\n// CheckLineGuard reports whether fileLine can be shown to exist inside the\n// read-only clone rooted at cloneRoot. nil means the line resolves.\nfunc CheckLineGuard(ctx context.Context, cloneRoot, repo, fileLine string) error {\n\tpath, line, ok := parseFileLine(fileLine)\n\tif !ok {\n\t\treturn errors.Errorf(ctx, \"%q not found in clone\", fileLine)\n\t}\n\trepoRoot := filepath.Join(cloneRoot, repo)\n\tresolvedRepoRoot, err := filepath.EvalSymlinks(repoRoot)\n\tif err != nil {\n\t\t// The clone or the repo directory is absent: nothing can be cited inside it.\n\t\treturn errors.Errorf(ctx, \"%q not found in clone\", path)\n\t}\n\ttarget := filepath.Join(resolvedRepoRoot, path)\n\tresolved, err := filepath.EvalSymlinks(target)\n\tif err != nil {\n\t\treturn resolveMissingAncestor(ctx, resolvedRepoRoot, target, path)\n\t}\n\tif !within(resolvedRepoRoot, resolved) {\n\t\treturn errors.Errorf(ctx, \"%q resolves outside the clone\", path)\n\t}\n\tdata, readErr := os.ReadFile(resolved)\n\tif readErr != nil {\n\t\treturn errors.Wrapf(ctx, readErr, \"read %q\", resolved)\n\t}\n\tcount := lineCount(data)\n\tif count < line {\n\t\treturn errors.Errorf(ctx, \"%q beyond end of file (%d lines)\", fileLine, count)\n\t}\n\treturn nil\n}\n\n// resolveMissingAncestor handles a leaf that does not exist: it resolves the\n// deepest existing ancestor so a symlinked directory escaping the clone is\n// still reported as an escape rather than a missing file.\nfunc resolveMissingAncestor(\n\tctx context.Context,\n\tresolvedRepoRoot string,\n\ttarget string,\n\tpath string,\n) error {\n\tancestor := deepestExisting(target)\n\tresolvedAncestor, err := filepath.EvalSymlinks(ancestor)\n\tif err != nil {\n\t\tresolvedAncestor = filepath.Clean(ancestor)\n\t}\n\tif !within(resolvedRepoRoot, resolvedAncestor) {\n\t\treturn errors.Errorf(ctx, \"%q resolves outside the clone\", path)\n\t}\n\treturn errors.Errorf(ctx, \"%q not found in clone\", path)\n}\n\n// deepestExisting returns target itself if it exists, else the closest\n// ancestor that does.\nfunc deepestExisting(target string) string {\n\tcurrent := target\n\tfor {\n\t\tif _, err := os.Lstat(current); err == nil {\n\t\t\treturn current\n\t\t}\n\t\tparent := filepath.Dir(current)\n\t\tif parent == current {\n\t\t\treturn current\n\t\t}\n\t\tcurrent = parent\n\t}\n}\n\n// within reports whether target is root or lies below it.\nfunc within(root, target string) bool {\n\treturn target == root || strings.HasPrefix(target, root+string(os.PathSeparator))\n}\n\n// lineCount counts \\n-separated lines, not counting a single trailing newline\n// as an extra line.\nfunc lineCount(data []byte) int {\n\treturn len(strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\"))\n}\n\n// parseFileLine parses \"<repo-relative path>:<positive integer>\".\nfunc parseFileLine(fileLine string) (string, int, bool) {\n\tindex := strings.LastIndex(fileLine, \":\")\n\tif index < 0 {\n\t\treturn \"\", 0, false\n\t}\n\tpath := fileLine[:index]\n\tlineText := fileLine[index+1:]\n\tif !validRepoRelativePath(path) {\n\t\treturn \"\", 0, false\n\t}\n\tline, err := strconv.Atoi(lineText)\n\tif err != nil || line <= 0 {\n\t\treturn \"\", 0, false\n\t}\n\treturn path, line, true\n}\n\n// validRepoRelativePath reports whether path is non-empty, relative and free of\n// any \"..\" segment.\nfunc validRepoRelativePath(path string) bool {\n\tif path == \"\" || strings.HasPrefix(path, \"/\") {\n\t\treturn false\n\t}\n\tfor _, segment := range strings.Split(path, \"/\") {\n\t\tif segment == \"..\" {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n===VERDICT===\n// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\n// Package verdict implements the deterministic referee for the defect\n// diagnoser. The model writes the \"## Verdict\"; this package decides whether\n// that verdict stands. It owns the model-output heading rule, the verdict gate\n// rules a-k, the line guard and the step wrappers that run them inside the\n// phase chain.\npackage verdict\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"strings\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\t\"gopkg.in/yaml.v3\"\n)\n\n// Field names, in the contract's order.\nconst (\n\tFieldDefectID       = \"defect_id\"\n\tFieldService        = \"service\"\n\tFieldRepo           = \"repo\"\n\tFieldFileLine       = \"file:line\"\n\tFieldRootCause      = \"root_cause\"\n\tFieldRecommendedFix = \"recommended_fix\"\n\tFieldEvidence       = \"evidence\"\n\tFieldConfidence     = \"confidence\"\n)\n\n// Confidence values, case-sensitive.\nconst (\n\tConfidenceHigh   = \"High\"\n\tConfidenceMedium = \"Medium\"\n\tConfidenceLow    = \"Low\"\n)\n\n// VerdictSectionHeading is the heading of the section that carries the verdict.\nconst VerdictSectionHeading = \"## Verdict\"\n\n// VerdictFieldOrder is the eight field names in the contract's order.\nvar VerdictFieldOrder = []string{\n\tFieldDefectID,\n\tFieldService,\n\tFieldRepo,\n\tFieldFileLine,\n\tFieldRootCause,\n\tFieldRecommendedFix,\n\tFieldEvidence,\n\tFieldConfidence,\n}\n\n// Verdict is the parsed ## Verdict contract block.\ntype Verdict struct {\n\tDefectID       string\n\tService        string\n\tRepo           string\n\tFileLine       string\n\tRootCause      string\n\tRecommendedFix string\n\tEvidence       string\n\tConfidence     string\n}\n\n// parseOutcome distinguishes rule a's four failures.\ntype parseOutcome int\n\nconst (\n\tparseOK parseOutcome = iota\n\tparseNoSection\n\tparseNoBlock\n\tparseInvalidYAML\n)\n\n// fields holds the ## Verdict yaml block's values keyed by the contract's field\n// names. A key is absent when the field is missing from the block; a nil yaml\n// value is normalised to the empty string (never the literal \"<nil>\").\ntype fields map[string]string\n\n// newVerdict reads the eight contract fields out of fields in order.\nfunc newVerdict(f fields) Verdict {\n\treturn Verdict{\n\t\tDefectID:       f[FieldDefectID],\n\t\tService:        f[FieldService],\n\t\tRepo:           f[FieldRepo],\n\t\tFileLine:       f[FieldFileLine],\n\t\tRootCause:      f[FieldRootCause],\n\t\tRecommendedFix: f[FieldRecommendedFix],\n\t\tEvidence:       f[FieldEvidence],\n\t\tConfidence:     f[FieldConfidence],\n\t}\n}\n\n// extractFields reads the last fenced ```yaml block of the ## Verdict section.\nfunc extractFields(ctx context.Context, md *agentlib.Markdown) (fields, parseOutcome) {\n\tsection, ok := md.FindSection(VerdictSectionHeading)\n\tif !ok {\n\t\treturn nil, parseNoSection\n\t}\n\tblock, ok := lastYAMLBlock(section.Body)\n\tif !ok {\n\t\treturn nil, parseNoBlock\n\t}\n\tvar raw map[string]interface{}\n\tif err := yaml.Unmarshal([]byte(block), &raw); err != nil {\n\t\treturn nil, parseInvalidYAML\n\t}\n\treturn normaliseFields(ctx, raw), parseOK\n}\n\n// lastYAMLBlock returns the body of the last complete fenced ```yaml block.\n// A block that opens and never closes is not counted.\nfunc lastYAMLBlock(body string) (string, bool) {\n\tvar (\n\t\tblocks  []string\n\t\tcurrent []string\n\t\tinBlock bool\n\t)\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif !inBlock {\n\t\t\tif trimmed == \"```yaml\" {\n\t\t\t\tinBlock = true\n\t\t\t\tcurrent = nil\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif trimmed == \"```\" {\n\t\t\tblocks = append(blocks, strings.Join(current, \"\\n\"))\n\t\t\tinBlock = false\n\t\t\tcontinue\n\t\t}\n\t\tcurrent = append(current, line)\n\t}\n\tif len(blocks) == 0 {\n\t\treturn \"\", false\n\t}\n\treturn blocks[len(blocks)-1], true\n}\n\n// normaliseFields converts every present contract key to a string. A nil value\n// becomes the empty string; a key absent from the block stays absent.\nfunc normaliseFields(_ context.Context, raw map[string]interface{}) fields {\n\tout := make(fields, len(VerdictFieldOrder))\n\tfor _, name := range VerdictFieldOrder {\n\t\tvalue, present := raw[name]\n\t\tif !present {\n\t\t\tcontinue\n\t\t}\n\t\tif value == nil {\n\t\t\tout[name] = \"\"\n\t\t\tcontinue\n\t\t}\n\t\tout[name] = fmt.Sprintf(\"%v\", value)\n\t}\n\treturn out\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"65223de2-d5ca-493e-b6ca-024741641a7c","uuid":"16c99e2f-14a6-423a-b959-04aab73d14af","timestamp":"2026-11-26T19:02:43.918Z","tool_use_result":{"stdout":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage verdict\n\nimport (\n\t\"context\"\n\t\"st