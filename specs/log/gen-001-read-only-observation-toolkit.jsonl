{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9827982ee412e320","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage factory_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tagentlib \"github.com/bborbe/agent\"\n11\t\tclaudelib \"github.com/bborbe/agent/claude\"\n12\t\tlibkafka \"github.com/bborbe/kafka\"\n13\t\t. \"github.com/onsi/ginkgo/v2\"\n14\t\t. \"github.com/onsi/gomega\"\n15\t\n16\t\t\"github.com/bborbe/defect-diagnoser-agent/pkg/factory\"\n17\t)\n18\t\n19\tvar _ = Describe(\"CreateAgentProvider\", func() {\n20\t\tvar (\n21\t\t\tctx      context.Context\n22\t\t\tprovider agentlib.AgentProvider\n23\t\t)\n24\t\n25\t\tBeforeEach(func() {\n26\t\t\tctx = context.Background()\n27\t\t\tprovider = factory.CreateAgentProvider(\n28\t\t\t\tclaudelib.ClaudeConfigDir(\"\"),\n29\t\t\t\tclaudelib.AgentDir(\"agent\"),\n30\t\t\t\tclaudelib.AllowedTools{},\n31\t\t\t\tclaudelib.ClaudeModel(\"sonnet\"),\n32\t\t\t\tmap[string]string{},\n33\t\t\t\tmap[string]string{},\n34\t\t\t)\n35\t\t})\n36\t\n37\t\tIt(\"returns a non-nil provider\", func() {\n38\t\t\tExpect(provider).NotTo(BeNil())\n39\t\t})\n40\t\n41\t\tIt(\"Get returns the domain agent for TaskTypeLLM\", func() {\n42\t\t\tagent, err := provider.Get(ctx, agentlib.TaskTypeLLM)\n43\t\t\tExpect(err).To(BeNil())\n44\t\t\tExpect(agent).NotTo(BeNil())\n45\t\t})\n46\t\n47\t\tIt(\"Get returns the liveness agent for TaskTypeHealthcheck\", func() {\n48\t\t\tagent, err := provider.Get(ctx, agentlib.TaskTypeHealthcheck)\n49\t\t\tExpect(err).To(BeNil())\n50\t\t\tExpect(agent).NotTo(BeNil())\n51\t\t})\n52\t\n53\t\tIt(\"Get returns the SAME liveness agent for TaskTypeOAuthProbe (alias)\", func() {\n54\t\t\thealthcheckAgent, err := provider.Get(ctx, agentlib.TaskTypeHealthcheck)\n55\t\t\tExpect(err).To(BeNil())\n56\t\t\toauthProbeAgent, err := provider.Get(ctx, agentlib.TaskTypeOAuthProbe)\n57\t\t\tExpect(err).To(BeNil())\n58\t\t\tExpect(oauthProbeAgent).To(BeIdenticalTo(healthcheckAgent))\n59\t\t})\n60\t\n61\t\tDescribe(\"Get with unknown task_type\", func() {\n62\t\t\tvar err error\n63\t\n64\t\t\tBeforeEach(func() {\n65\t\t\t\t_, err = provider.Get(ctx, agentlib.TaskType(\"bogus\"))\n66\t\t\t})\n67\t\n68\t\t\tIt(\"returns an error\", func() {\n69\t\t\t\tExpect(err).To(HaveOccurred())\n70\t\t\t})\n71\t\n72\t\t\tIt(\"error message contains the unknown task_type literal\", func() {\n73\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"unknown task_type\"))\n74\t\t\t})\n75\t\n76\t\t\tIt(\"error message contains the offending value quoted\", func() {\n77\t\t\t\tExpect(err.Error()).To(ContainSubstring(`\"bogus\"`))\n78\t\t\t})\n79\t\n80\t\t\tIt(\"error message contains the binary name\", func() {\n81\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"defect-diagnoser-agent\"))\n82\t\t\t})\n83\t\n84\t\t\tIt(\"error message contains the sorted accepted-types list\", func() {\n85\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"[healthcheck llm oauth-probe]\"))\n86\t\t\t})\n87\t\t})\n88\t})\n89\t\n90\tvar _ = Describe(\"CreateSyncProducer\", func() {\n91\t\tvar ctx context.Context\n92\t\n93\t\tBeforeEach(func() {\n94\t\t\tctx = context.Background()\n95\t\t})\n96\t\n97\t\tIt(\"returns an error when broker is unreachable\", func() {\n98\t\t\tproducer, err := factory.CreateSyncProducer(ctx, libkafka.Brokers{})\n99\t\t\tExpect(producer).To(BeNil())\n100\t\t\tExpect(err).NotTo(BeNil())\n101\t\t\tExpect(err.Error()).To(ContainSubstring(\"create sync producer\"))\n102\t\t})\n103\t})\n104\t\n105\tvar _ = Describe(\"CreateKafkaResultDeliverer\", func() {\n106\t\tIt(\"returns a non-nil ResultDeliverer\", func() {\n107\t\t\tdeliverer := factory.CreateKafkaResultDeliverer(\n108\t\t\t\tnil,\n109\t\t\t\t\"\",\n110\t\t\t\t\"\",\n111\t\t\t\t\"\",\n112\t\t\t\tnil,\n113\t\t\t)\n114\t\t\tExpect(deliverer).NotTo(BeNil())\n115\t\t})\n116\t})\n117\t\n118\tvar _ = Describe(\"CreateFileResultDeliverer\", func() {\n119\t\tIt(\"returns a non-nil ResultDeliverer\", func() {\n120\t\t\tdeliverer := factory.CreateFileResultDeliverer(\"/tmp/test-output.md\")\n121\t\t\tExpect(deliverer).NotTo(BeNil())\n122\t\t})\n123\t})\n124\t\n125\tvar _ = Describe(\"CreateAgent\", func() {\n126\t\tIt(\"returns a non-nil *agentlib.Agent\", func() {\n127\t\t\tagent := factory.CreateAgent(\n128\t\t\t\t\"\",\n129\t\t\t\t\"\",\n130\t\t\t\tnil,\n131\t\t\t\t\"\",\n132\t\t\t\tnil,\n133\t\t\t\tnil,\n134\t\t\t)\n135\t\t\tExpect(agent).NotTo(BeNil())\n136\t\t})\n137\t})\n138\t"}]},"parent_tool_use_id":"chatcmpl-tool-94115c2446396ba4","session_id":"31f2fa85-d626-41fe-b66d-5257d5b0f933","uuid":"8b28975e-154a-47ce-84bf-b0282c169b5e","timestamp":"2026-09-27T22:27:53.346Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 001"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-af50a5f2e5fd4613","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package factory wires concrete dependencies for the defect-diagnoser-agent binary.\n6\t//\n7\t// All factory functions follow the Create* prefix convention and contain\n8\t// zero business logic — they compose constructors with config.\n9\tpackage factory\n10\t\n11\timport (\n12\t\t\"context\"\n13\t\n14\t\tagentlib \"github.com/bborbe/agent\"\n15\t\tclaudelib \"github.com/bborbe/agent/claude\"\n16\t\tdelivery \"github.com/bborbe/agent/delivery\"\n17\t\thealthcheck \"github.com/bborbe/agent/healthcheck\"\n18\t\t\"github.com/bborbe/cqrs/base\"\n19\t\tlibkafka \"github.com/bborbe/kafka\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n22\t\n23\t\t\"github.com/bborbe/defect-diagnoser-agent/pkg/prompts\"\n24\t)\n25\t\n26\tconst serviceName = \"defect-diagnoser-agent\"\n27\t\n28\t// CreateClaudeRunner constructs a ClaudeRunner pre-configured with tools,\n29\t// model, working directory, and CLI environment.\n30\tfunc CreateClaudeRunner(\n31\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n32\t\tagentDir claudelib.AgentDir,\n33\t\tallowedTools claudelib.AllowedTools,\n34\t\tmodel claudelib.ClaudeModel,\n35\t\tenv map[string]string,\n36\t) claudelib.ClaudeRunner {\n37\t\treturn claudelib.NewClaudeRunner(claudelib.ClaudeRunnerConfig{\n38\t\t\tClaudeConfigDir:  claudeConfigDir,\n39\t\t\tAllowedTools:     allowedTools,\n40\t\t\tModel:            model,\n41\t\t\tWorkingDirectory: agentDir,\n42\t\t\tEnv:              env,\n43\t\t})\n44\t}\n45\t\n46\t// CreateSyncProducer creates a Kafka sync producer.\n47\tfunc CreateSyncProducer(\n48\t\tctx context.Context,\n49\t\tbrokers libkafka.Brokers,\n50\t) (libkafka.SyncProducer, error) {\n51\t\treturn libkafka.NewSyncProducerWithName(ctx, brokers, serviceName)\n52\t}\n53\t\n54\t// CreateKafkaResultDeliverer creates a ResultDeliverer that publishes task\n55\t// updates to Kafka via CQRS commands. Uses the passthrough content generator\n56\t// — the agent framework's StepRunner already produces the full marshaled\n57\t// task in result.Output; the deliverer publishes it as-is and overrides\n58\t// status/phase frontmatter based on the result Status.\n59\tfunc CreateKafkaResultDeliverer(\n60\t\tsyncProducer libkafka.SyncProducer,\n61\t\ttopicPrefix base.TopicPrefix,\n62\t\ttaskID agentlib.TaskIdentifier,\n63\t\toriginalContent string,\n64\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n65\t) agentlib.ResultDeliverer {\n66\t\treturn delivery.NewKafkaResultDeliverer(\n67\t\t\tsyncProducer,\n68\t\t\ttopicPrefix,\n69\t\t\ttaskID,\n70\t\t\toriginalContent,\n71\t\t\tdelivery.NewPassthroughContentGenerator(),\n72\t\t\tcurrentDateTime,\n73\t\t)\n74\t}\n75\t\n76\t// CreateFileResultDeliverer creates a ResultDeliverer that writes the agent's\n77\t// output back to a markdown file (local CLI mode). Uses the passthrough\n78\t// content generator (same rationale as Kafka).\n79\tfunc CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer {\n80\t\treturn delivery.NewFileResultDeliverer(\n81\t\t\tdelivery.NewPassthroughContentGenerator(),\n82\t\t\tfilePath,\n83\t\t)\n84\t}\n85\t\n86\t// CreateAgent assembles the full 3-phase claude agent. Single Claude step\n87\t// shared across planning / in_progress / ai_review preserves the existing\n88\t// CRD trigger.phases behavior — every phase runs Claude once and emits\n89\t// done.\n90\tfunc CreateAgent(\n91\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n92\t\tagentDir claudelib.AgentDir,\n93\t\tallowedTools claudelib.AllowedTools,\n94\t\tmodel claudelib.ClaudeModel,\n95\t\tclaudeEnv map[string]string,\n96\t\tenvContext map[string]string,\n97\t) *agentlib.Agent {\n98\t\treturn CreateAgentFromRunner(\n99\t\t\tCreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv),\n100\t\t\tenvContext,\n101\t\t)\n102\t}\n103\t\n104\t// CreateAgentFromRunner builds the 3-phase claude agent given a pre-constructed\n105\t// ClaudeRunner. Used by CreateAgentProvider to share one runner across the\n106\t// domain agent and the healthcheck-Claude liveness agent.\n107\tfunc CreateAgentFromRunner(\n108\t\trunner claudelib.ClaudeRunner,\n109\t\tenvContext map[string]string,\n110\t) *agentlib.Agent {\n111\t\tstep := claudelib.NewAgentStep(claudelib.AgentStepConfig{\n112\t\t\tName:          \"claude-task\",\n113\t\t\tRunner:        runner,\n114\t\t\tInstructions:  prompts.BuildInstructions(),\n115\t\t\tEnvContext:    envContext,\n116\t\t\tOutputSection: \"## Result\",\n117\t\t\tNextPhase:     \"done\",\n118\t\t})\n119\t\treturn agentlib.NewAgent(\n120\t\t\tagentlib.NewPhase(\"planning\", step),\n121\t\t\tagentlib.NewPhase(domain.TaskPhaseExecution, step),\n122\t\t\tagentlib.NewPhase(\"ai_review\", step),\n123\t\t)\n124\t}\n125\t\n126\t// CreateAgentProvider wires the per-task-type dispatch table for defect-diagnoser-agent.\n127\t// Returns lib.AgentProvider — main.go calls Get(ctx, taskType) to select the\n128\t// appropriate *Agent. Pure plumbing; no conditional, no error.\n129\t//\n130\t// TaskTypeLLM routes to the existing 3-phase domain agent. TaskTypeHealthcheck\n131\t// and TaskTypeOAuthProbe (transition alias) both route to the shared\n132\t// healthcheck-Claude liveness agent, reusing the same ClaudeRunner.\n133\tfunc CreateAgentProvider(\n134\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n135\t\tagentDir claudelib.AgentDir,\n136\t\tallowedTools claudelib.AllowedTools,\n137\t\tmodel claudelib.ClaudeModel,\n138\t\tclaudeEnv map[string]string,\n139\t\tenvContext map[string]string,\n140\t) agentlib.AgentProvider {\n141\t\trunner := CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv)\n142\t\tdomainAgent := CreateAgentFromRunner(runner, envContext)\n143\t\tlivenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(runner))\n144\t\treturn agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n145\t\t\tagentlib.TaskTypeLLM:         domainAgent,\n146\t\t\tagentlib.TaskTypeHealthcheck: livenessAgent,\n147\t\t\tagentlib.TaskTypeOAuthProbe:  livenessAgent,\n148\t\t})\n149\t}\n150\t"}]},"parent_tool_use_id":"chatcmpl-tool-94115c2446396ba4","session_id":"31f2fa85-d626-41fe-b66d-5257d5b0f933","uuid":"9cf81a45-6f1c-4bd9-840a-e08766c44520","timestamp":"2026-09-27T22:27:53.347Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 001"}
