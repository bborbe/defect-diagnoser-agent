r k, v := range env {\n\t\tchildEnv = append(childEnv, k+\"=\"+v)\n\t}\n\tcmd.Env = childEnv\n\tvar stdout, stderr strings.Builder\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\terr := cmd.Run()\n\tcode := 0\n\tif err != nil {\n\t\tvar exitErr *exec.ExitError\n\t\tif ok := As(err, &exitErr); ok {\n\t\t\tcode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tcode = -1\n\t\t}\n\t}\n\treturn stdout.String(), stderr.String(), code\n}\n\nfunc scriptPath(name string) string {\n\treturn filepath.Join(repoRoot(), \"agent\", \"scripts\", name)\n}\n\nvar _ = Describe(\"prometheus-query.sh\", func() {\n\tIt(\"sends exactly one GET and returns the body\", func() {\n\t\tserver, rec := newRecordingServer(GinkgoT(), http.StatusOK, \"hello\")\n\t\tstdout, _, code := runScript(GinkgoT(), scriptPath(\"prometheus-query.sh\"), map[string]string{\"PROMETHEUS_URL\": server.URL}, \"up\")\n\t\tExpect(code).To(Equal(0))\n\t\tExpect(stdout).To(Equal(\"hello\"))\n\t\treqs := rec.all()\n\t\tExpect(reqs).To(HaveLen(1))\n\t\tExpect(reqs[0].method).To(Equal(\"GET\"))\n\t\tExpect(reqs[0].path).To(Equal(\"/api/v1/query\"))\n\t})\n})\nGOEOF\ntimeout 500 go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.1 run --allow-parallel-runners --config .golangci.yml ./pkg/scripts/... 2>&1 | tail -40; echo \"EXIT=${PIPESTATUS[0]}\"","description":"Lint a representative test file following the prompt harness","timeout":540000}}],"model":"deepseek-v4-flash-max","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":"chatcmpl-tool-9484eac8eb1e4e34","session_id":"31f2fa85-d626-41fe-b66d-5257d5b0f933","uuid":"c92128c4-c66e-4269-9cfb-b7f8f542cce0","timestamp":"2026-09-27T22:49:07.783Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1"}
