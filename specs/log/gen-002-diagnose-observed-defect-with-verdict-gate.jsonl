{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-95d3c8164792b24b","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"sort\"\n10\t\n11\t\t\"github.com/bborbe/errors\"\n12\t)\n13\t\n14\t//counterfeiter:generate -o mocks/agent-agent-provider.go --fake-name AgentAgentProvider . AgentProvider\n15\t\n16\t// AgentProvider returns the *Agent registered for a given TaskType.\n17\t// Implementations are typically configured at boot via NewAgentProvider with\n18\t// a binary-specific dispatch table; the Get method is called once per task\n19\t// at the Kafka entry point.\n20\ttype AgentProvider interface {\n21\t\tGet(ctx context.Context, taskType TaskType) (*Agent, error)\n22\t}\n23\t\n24\t// NewAgentProvider wires a task_type → *Agent dispatch table. The name argument\n25\t// identifies the consuming binary in the error message returned on a map miss\n26\t// (e.g. \"agent-claude\") and should match the binary's serviceName constant.\n27\t//\n28\t// The agents map is captured by reference; callers must not mutate it after\n29\t// construction. Pass a freshly-built map.\n30\tfunc NewAgentProvider(name string, agents map[TaskType]*Agent) AgentProvider {\n31\t\treturn &agentProvider{name: name, agents: agents}\n32\t}\n33\t\n34\ttype agentProvider struct {\n35\t\tname   string\n36\t\tagents map[TaskType]*Agent\n37\t}\n38\t\n39\t// Get returns the *Agent registered for taskType. On a map miss, it returns\n40\t// nil and an errors.Errorf-wrapped error whose message names the offending\n41\t// task_type value, the provider's name, and the sorted list of accepted\n42\t// constants.\n43\tfunc (p *agentProvider) Get(ctx context.Context, taskType TaskType) (*Agent, error) {\n44\t\tif agent, ok := p.agents[taskType]; ok {\n45\t\t\treturn agent, nil\n46\t\t}\n47\t\taccepted := make([]string, 0, len(p.agents))\n48\t\tfor tt := range p.agents {\n49\t\t\taccepted = append(accepted, string(tt))\n50\t\t}\n51\t\tsort.Strings(accepted)\n52\t\treturn nil, errors.Errorf(\n53\t\t\tctx,\n54\t\t\t\"unknown task_type %q for %s; accepted: %v\",\n55\t\t\ttaskType, p.name, accepted,\n56\t\t)\n57\t}\n58\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"ff18a48d-09a4-491a-8a9e-00cb1265377b","timestamp":"2026-09-27T22:59:33.174Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b684f186a65db291","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage healthcheck\n6\t\n7\timport (\n8\t\tagentlib \"github.com/bborbe/agent\"\n9\t)\n10\t\n11\t// NewAgent wraps any Step in a phase-agnostic *agentlib.Agent.\n12\t// The step is registered under all three canonical phase names so the\n13\t// healthcheck task succeeds regardless of which PHASE env the executor\n14\t// injects (planning, execution, ai_review per CLAUDE.md doctrine).\n15\tfunc NewAgent(step agentlib.Step) *agentlib.Agent {\n16\t\treturn agentlib.NewAgent(\n17\t\t\tagentlib.NewPhase(\"planning\", step),\n18\t\t\tagentlib.NewPhase(\"execution\", step),\n19\t\t\tagentlib.NewPhase(\"ai_review\", step),\n20\t\t)\n21\t}\n22\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"70e6b632-1b82-4fb3-a1a7-314334f485ed","timestamp":"2026-09-27T22:59:33.175Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bed733b48ed8e8a4","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"time\"\n9\t\n10\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n11\t)\n12\t\n13\t// TaskFrontmatter is a generic map of frontmatter key-value pairs.\n14\t// Serializable as JSON (Kafka) and YAML (vault file).\n15\t// Typed accessors provide type-safe access to well-known fields.\n16\ttype TaskFrontmatter map[string]interface{}\n17\t\n18\tfunc (f TaskFrontmatter) Status() domain.TaskStatus {\n19\t\tv, _ := f[\"status\"].(string)\n20\t\tif canonical, ok := domain.NormalizeTaskStatus(v); ok {\n21\t\t\treturn canonical\n22\t\t}\n23\t\treturn domain.TaskStatus(v)\n24\t}\n25\t\n26\tfunc (f TaskFrontmatter) Phase() *domain.TaskPhase {\n27\t\tv, ok := f[\"phase\"].(string)\n28\t\tif !ok || v == \"\" {\n29\t\t\treturn nil\n30\t\t}\n31\t\tif canonical, ok := domain.NormalizeTaskPhase(v); ok {\n32\t\t\treturn &canonical\n33\t\t}\n34\t\tp := domain.TaskPhase(v)\n35\t\treturn &p\n36\t}\n37\t\n38\tfunc (f TaskFrontmatter) Assignee() TaskAssignee {\n39\t\tv, _ := f[\"assignee\"].(string)\n40\t\treturn TaskAssignee(v)\n41\t}\n42\t\n43\t// TaskType returns the task_type frontmatter field as a typed TaskType.\n44\t// Returns TaskType(\"\") when the field is absent or holds a non-string value.\n45\tfunc (f TaskFrontmatter) TaskType() TaskType {\n46\t\tv, _ := f[\"task_type\"].(string)\n47\t\treturn TaskType(v)\n48\t}\n49\t\n50\t// Stage returns the execution stage from the \"stage\" key.\n51\t// Returns \"prod\" if the key is absent or empty.\n52\tfunc (f TaskFrontmatter) Stage() string {\n53\t\tv, _ := f[\"stage\"].(string)\n54\t\tif v == \"\" {\n55\t\t\treturn \"prod\"\n56\t\t}\n57\t\treturn v\n58\t}\n59\t\n60\t// RetryCount returns the number of failed attempts recorded in frontmatter.\n61\t// Returns 0 when the field is absent.\n62\tfunc (f TaskFrontmatter) RetryCount() int {\n63\t\tswitch v := f[\"retry_count\"].(type) {\n64\t\tcase int:\n65\t\t\treturn v\n66\t\tcase float64:\n67\t\t\treturn int(v)\n68\t\tdefault:\n69\t\t\treturn 0\n70\t\t}\n71\t}\n72\t\n73\t// MaxRetries returns the maximum number of failures allowed before escalation.\n74\t// Returns 3 when the field is absent (spec default).\n75\tfunc (f TaskFrontmatter) MaxRetries() int {\n76\t\tswitch v := f[\"max_retries\"].(type) {\n77\t\tcase int:\n78\t\t\treturn v\n79\t\tcase float64:\n80\t\t\treturn int(v)\n81\t\tdefault:\n82\t\t\treturn 3\n83\t\t}\n84\t}\n85\t\n86\t// TriggerCount returns the number of spawn-trigger events that have fired for this task.\n87\t// Returns 0 if the field is absent.\n88\tfunc (f TaskFrontmatter) TriggerCount() int {\n89\t\tswitch v := f[\"trigger_count\"].(type) {\n90\t\tcase int:\n91\t\t\treturn v\n92\t\tcase float64:\n93\t\t\treturn int(v)\n94\t\tdefault:\n95\t\t\treturn 0\n96\t\t}\n97\t}\n98\t\n99\t// MaxTriggers returns the maximum number of spawn-trigger events allowed for this task.\n100\t// Returns 3 if the field is absent, matching the default for max_retries.\n101\tfunc (f TaskFrontmatter) MaxTriggers() int {\n102\t\tswitch v := f[\"max_triggers\"].(type) {\n103\t\tcase int:\n104\t\t\treturn v\n105\t\tcase float64:\n106\t\t\treturn int(v)\n107\t\tdefault:\n108\t\t\treturn 3\n109\t\t}\n110\t}\n111\t\n112\t// SpawnNotification returns true when this result is a job-spawn tracking update\n113\t// rather than an agent outcome. The controller skips the retry counter for these.\n114\tfunc (f TaskFrontmatter) SpawnNotification() bool {\n115\t\tv, _ := f[\"spawn_notification\"].(bool)\n116\t\treturn v\n117\t}\n118\t\n119\t// CurrentJob returns the K8s Job name recorded when the executor spawned a Job for this task.\n120\t// Returns an empty string when not set.\n121\tfunc (f TaskFrontmatter) CurrentJob() string {\n122\t\tv, _ := f[\"current_job\"].(string)\n123\t\treturn v\n124\t}\n125\t\n126\t// JobStartedAt parses the job_started_at frontmatter field written by PublishSpawnNotification.\n127\t// Returns (time.Time{}, nil) when the field is absent — callers treat zero time as \"grace elapsed\".\n128\t// Returns (time.Time{}, err) when the field is present but unparseable.\n129\tfunc (f TaskFrontmatter) JobStartedAt() (time.Time, error) {\n130\t\tv, _ := f[\"job_started_at\"].(string)\n131\t\tif v == \"\" {\n132\t\t\treturn time.Time{}, nil\n133\t\t}\n134\t\tt, err := time.Parse(time.RFC3339, v)\n135\t\tif err != nil {\n136\t\t\treturn time.Time{}, err\n137\t\t}\n138\t\treturn t, nil\n139\t}\n140\t\n141\t// String reads a string field by key. ok is false when the key is absent\n142\t// or holds a non-string value. Generic accessor for ad-hoc fields without\n143\t// dedicated typed methods.\n144\tfunc (f TaskFrontmatter) String(key string) (string, bool) {\n145\t\tv, ok := f[key]\n146\t\tif !ok {\n147\t\t\treturn \"\", false\n148\t\t}\n149\t\ts, ok := v.(string)\n150\t\treturn s, ok\n151\t}\n152\t\n153\t// Int reads an integer field by key, accepting both int (JSON-decoded) and\n154\t// float64 (YAML-decoded) underlying types. ok is false when the key is\n155\t// absent or holds a non-numeric value. Generic accessor for ad-hoc fields\n156\t// without dedicated typed methods.\n157\tfunc (f TaskFrontmatter) Int(key string) (int, bool) {\n158\t\tv, ok := f[key]\n159\t\tif !ok {\n160\t\t\treturn 0, false\n161\t\t}\n162\t\tswitch n := v.(type) {\n163\t\tcase int:\n164\t\t\treturn n, true\n165\t\tcase float64:\n166\t\t\treturn int(n), true\n167\t\t}\n168\t\treturn 0, false\n169\t}\n170\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"b08baec2-2997-4ecb-ae85-c3180dddf168","timestamp":"2026-09-27T22:59:33.176Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-85b6d8d599a472ae","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage healthcheck\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/bborbe/errors\"\n12\t\n13\t\tagentlib \"github.com/bborbe/agent\"\n14\t\tclaudelib \"github.com/bborbe/agent/claude\"\n15\t)\n16\t\n17\t// NewClaudeStep returns a Step that runs a \"reply 'ok'\" smoke prompt via the\n18\t// configured Claude CLI runner. Used by the agent-claude binary to verify\n19\t// that its Claude CLI dependency is reachable.\n20\t//\n21\t// On success the Result.Message is populated with the trimmed reply text —\n22\t// this is intentional to capture the liveness response for operator log/audit.\n23\tfunc NewClaudeStep(runner claudelib.ClaudeRunner) agentlib.Step {\n24\t\treturn &claudeStep{runner: runner}\n25\t}\n26\t\n27\ttype claudeStep struct {\n28\t\trunner claudelib.ClaudeRunner\n29\t}\n30\t\n31\tfunc (s *claudeStep) Name() string { return \"healthcheck-claude\" }\n32\t\n33\tfunc (s *claudeStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n34\t\treturn true, nil\n35\t}\n36\t\n37\tfunc (s *claudeStep) Run(ctx context.Context, _ *agentlib.Markdown) (*agentlib.Result, error) {\n38\t\tresult, err := s.runner.Run(ctx, \"reply 'ok'\")\n39\t\tif err != nil {\n40\t\t\treturn &agentlib.Result{\n41\t\t\t\tStatus:  agentlib.AgentStatusFailed,\n42\t\t\t\tMessage: errors.Wrapf(ctx, err, \"healthcheck-claude run failed\").Error(),\n43\t\t\t}, nil\n44\t\t}\n45\t\ttrimmed := strings.TrimSpace(result.Result)\n46\t\tif trimmed == \"\" {\n47\t\t\treturn &agentlib.Result{\n48\t\t\t\tStatus:  agentlib.AgentStatusFailed,\n49\t\t\t\tMessage: \"healthcheck-claude reply empty\",\n50\t\t\t}, nil\n51\t\t}\n52\t\treturn &agentlib.Result{\n53\t\t\tStatus: agentlib.AgentStatusDone,\n54\t\t\t// Explicit terminal phase: Done with empty NextPhase is an in-place save\n55\t\t\t// (stay in current phase) — healthcheck tasks must actually complete.\n56\t\t\tNextPhase: \"done\",\n57\t\t\tMessage:   trimmed,\n58\t\t}, nil\n59\t}\n60\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"fc232810-201f-42f1-9685-6ae50cfd13e2","timestamp":"2026-09-27T22:59:33.177Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
