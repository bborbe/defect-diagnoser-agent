{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bca3de01816de8ba","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\n11\t\t\"github.com/bborbe/errors\"\n12\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n13\t)\n14\t\n15\t// Agent is a composed list of phases. Build via NewAgent.\n16\ttype Agent struct {\n17\t\tphases []Phase\n18\t}\n19\t\n20\t// NewAgent constructs an Agent from one or more phases.\n21\t//\n22\t// Phase names must be unique. Duplicates are rejected at Run time.\n23\tfunc NewAgent(phases ...Phase) *Agent {\n24\t\treturn &Agent{phases: phases}\n25\t}\n26\t\n27\t// Run dispatches by phase and walks the matching step list.\n28\t//\n29\t// phaseName is the requested phase from the K8s Job env (PHASE) or the\n30\t// CLI flag. Unknown or empty phaseName produces a Failed result via the\n31\t// deliverer (fail-loud sentinel — never a silent escalation).\n32\t//\n33\t// taskContent is parsed once into *Markdown; the parsed Markdown is\n34\t// mutated by successive steps and re-serialized for each save.\n35\t//\n36\t// On the happy path, Run walks phases sequentially in the same process:\n37\t// after a step publishes Done + NextPhase, if that NextPhase exists on\n38\t// this Agent, the loop runs it in-process instead of returning. The pod\n39\t// only exits on: result == nil, Status != Done, NextPhase == \"\"/\"done\"/\n40\t// \"human_review\"/not-in-this-agent, or ctx cancellation.\n41\t//\n42\t// Contract change: Done + NextPhase != \"\" no longer means \"exit pod\" —\n43\t// it means \"the Agent decides whether to advance internally or hand off\n44\t// to the executor\".\n45\tfunc (a *Agent) Run(\n46\t\tctx context.Context,\n47\t\tphaseName domain.TaskPhase,\n48\t\ttaskContent string,\n49\t\tdeliverer ResultDeliverer,\n50\t) (*Result, error) {\n51\t\tif err := a.validate(ctx); err != nil {\n52\t\t\treturn nil, err\n53\t\t}\n54\t\n55\t\tp, ok := a.findPhase(phaseName)\n56\t\tif !ok {\n57\t\t\treturn a.unsupportedPhase(ctx, phaseName, deliverer)\n58\t\t}\n59\t\n60\t\tmd, err := ParseMarkdown(ctx, taskContent)\n61\t\tif err != nil {\n62\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse markdown\")\n63\t\t}\n64\t\n65\t\t// Exit conditions (checked after each StepRunner.Run):\n66\t\t//  1. result == nil  — empty Steps or all ShouldRun=false\n67\t\t//  2. result.Status != AgentStatusDone  — Failed/NeedsInput/InProgress\n68\t\t//  3. result.NextPhase == \"\"  — terminal in-place save\n69\t\t//  4. result.NextPhase == \"done\"  — terminal literal\n70\t\t//  5. result.NextPhase == \"human_review\"  — escalation literal\n71\t\t//  6. ctx.Err() != nil  — cancelled between phases\n72\t\t//  7. findPhase(NextPhase) returns false  — NextPhase not in this Agent\n73\t\tvar lastResult *Result\n74\t\tfor {\n75\t\t\trunner := NewStepRunner(deliverer, p.Steps...)\n76\t\t\tresult, err := runner.Run(ctx, md)\n77\t\t\tif err != nil {\n78\t\t\t\treturn result, err\n79\t\t\t}\n80\t\n81\t\t\t// Check exit conditions before attempting next phase lookup.\n82\t\t\tif result == nil {\n83\t\t\t\treturn lastResult, nil\n84\t\t\t}\n85\t\t\tif result.Status != AgentStatusDone {\n86\t\t\t\treturn result, nil\n87\t\t\t}\n88\t\t\tif result.NextPhase == \"\" {\n89\t\t\t\treturn result, nil\n90\t\t\t}\n91\t\t\tif result.NextPhase == \"done\" {\n92\t\t\t\treturn result, nil\n93\t\t\t}\n94\t\t\tif result.NextPhase == \"human_review\" {\n95\t\t\t\treturn result, nil\n96\t\t\t}\n97\t\n98\t\t\t// Context cancellation check between iterations.\n99\t\t\tif ctx.Err() != nil {\n100\t\t\t\treturn result, errors.Wrapf(ctx, ctx.Err(), \"agent run cancelled between phases\")\n101\t\t\t}\n102\t\n103\t\t\t// Attempt to advance to next phase within this Agent.\n104\t\t\tnextPhase, ok := a.findPhase(domain.TaskPhase(result.NextPhase))\n105\t\t\tif !ok {\n106\t\t\t\treturn result, nil\n107\t\t\t}\n108\t\n109\t\t\tlastResult = result\n110\t\t\tp = nextPhase\n111\t\t}\n112\t}\n113\t\n114\t// validate checks for duplicate phase names.\n115\tfunc (a *Agent) validate(ctx context.Context) error {\n116\t\tseen := map[domain.TaskPhase]bool{}\n117\t\tfor _, p := range a.phases {\n118\t\t\tif seen[p.Name] {\n119\t\t\t\treturn errors.Errorf(ctx, \"agent: duplicate phase %q\", p.Name)\n120\t\t\t}\n121\t\t\tseen[p.Name] = true\n122\t\t}\n123\t\treturn nil\n124\t}\n125\t\n126\tfunc (a *Agent) findPhase(name domain.TaskPhase) (Phase, bool) {\n127\t\tfor _, p := range a.phases {\n128\t\t\tif p.Name == name {\n129\t\t\t\treturn p, true\n130\t\t\t}\n131\t\t}\n132\t\treturn Phase{}, false\n133\t}\n134\t\n135\t// unsupportedPhase publishes a Failed result with a clear message.\n136\tfunc (a *Agent) unsupportedPhase(\n137\t\tctx context.Context,\n138\t\tphaseName domain.TaskPhase,\n139\t\tdeliverer ResultDeliverer,\n140\t) (*Result, error) {\n141\t\tdisplay := string(phaseName)\n142\t\tif display == \"\" {\n143\t\t\tdisplay = \"(empty)\"\n144\t\t}\n145\t\tresult := &Result{\n146\t\t\tStatus:  AgentStatusFailed,\n147\t\t\tMessage: fmt.Sprintf(\"unsupported entry phase: %s\", display),\n148\t\t}\n149\t\tif err := deliverer.DeliverResult(ctx, AgentResultInfo{\n150\t\t\tStatus:  result.Status,\n151\t\t\tMessage: result.Message,\n152\t\t}); err != nil {\n153\t\t\treturn result, errors.Wrapf(ctx, err, \"deliver unsupported-phase\")\n154\t\t}\n155\t\treturn result, nil\n156\t}\n157\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"c4b5cecd-cc72-46c5-be27-de0a75f19328","timestamp":"2026-09-27T22:58:53.601Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-859dc1b9498c633d","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport \"context\"\n8\t\n9\t//counterfeiter:generate -o mocks/agent-step.go --fake-name AgentStep . Step\n10\t\n11\t// Step is one unit of work within a phase. Always code; may wrap AI calls.\n12\t//\n13\t// Three responsibilities:\n14\t//   - Name: identifies the step in logs and tests.\n15\t//   - ShouldRun: cheap guard that inspects task state to decide skip vs run.\n16\t//   - Run: performs work, mutating markdown in-place. Returns a Result\n17\t//     describing status + phase transition (NOT body content — body changes\n18\t//     happen via markdown.AddSection / ReplaceSection / Frontmatter mutation).\n19\ttype Step interface {\n20\t\t// Name identifies the step. Convention: lower-kebab-case.\n21\t\tName() string\n22\t\n23\t\t// ShouldRun returns true if the step should execute. Inspects markdown\n24\t\t// state (frontmatter, sections) and returns false if the step has\n25\t\t// already completed (idempotency guard).\n26\t\t//\n27\t\t// Guards must be cheap — no expensive I/O. Use existing markdown state.\n28\t\tShouldRun(ctx context.Context, md *Markdown) (bool, error)\n29\t\n30\t\t// Run performs the step's work, mutating markdown in-place. Returns a\n31\t\t// Result describing status + phase transition. Body content changes\n32\t\t// flow through markdown.AddSection / ReplaceSection; frontmatter\n33\t\t// changes flow through direct map mutation.\n34\t\t//\n35\t\t// The framework re-serializes markdown via Marshal after Run returns\n36\t\t// and publishes the new content via the deliverer.\n37\t\tRun(ctx context.Context, md *Markdown) (*Result, error)\n38\t}\n39\t\n40\t// Result tells the StepRunner what status to deliver and whether to advance.\n41\t//\n42\t// Body and frontmatter changes are NOT in Result — they're applied by\n43\t// mutating *Markdown in Run. This keeps the durability model clear: at any\n44\t// point during Run, the Markdown IS the durable view.\n45\ttype Result struct {\n46\t\t// Status: Done | InProgress | Failed | NeedsInput.\n47\t\tStatus AgentStatus\n48\t\n49\t\t// NextPhase advances the phase frontmatter on Status: Done. Empty\n50\t\t// means \"stay in current phase\" — used for in-place saves between\n51\t\t// steps in a multi-step phase.\n52\t\tNextPhase string\n53\t\n54\t\t// Message is a human-readable status. Required for Failed/NeedsInput.\n55\t\tMessage string\n56\t\n57\t\t// ContinueToNext signals whether the StepRunner should proceed to\n58\t\t// the next step in the same Job invocation (true) or exit and let\n59\t\t// the controller re-trigger the same phase (false).\n60\t\t//\n61\t\t// Default is exit-after-save. Multi-step phases set this to true on\n62\t\t// intermediate steps and let the last step decide.\n63\t\tContinueToNext bool\n64\t\n65\t\t// AgentTurns is the number of conversation turns the session that produced this\n66\t\t// result took, from the CLI's own end-of-run summary. Nil means no measurement was\n67\t\t// reported — a zero or negative summary is treated as no measurement, and the turn\n68\t\t// entry is then omitted from the payload entirely.\n69\t\tAgentTurns *int64\n70\t\n71\t\t// InteractionCount is the number of human-authored entries the run's own session\n72\t\t// transcript recorded. Nil means the evidence was unavailable — the interaction\n73\t\t// entry is omitted from the payload. A non-nil zero is an observation: the\n74\t\t// transcript was read and contained no human-authored entry. Absence is never\n75\t\t// substituted with a zero.\n76\t\tInteractionCount *int64\n77\t}\n78\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"094031bd-1368-4cda-bc42-28810098856f","timestamp":"2026-09-27T22:58:53.602Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-88959836117f8b37","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport \"github.com/bborbe/vault-cli/pkg/domain\"\n8\t\n9\t// Phase ties a phase name to an ordered list of steps.\n10\t//\n11\t// Compose with NewAgent:\n12\t//\n13\t//\tNewAgent(\n14\t//\t    NewPhase(\"planning\",   NewParseStep(parser, \"## Plan\", \"in_progress\")),\n15\t//\t    NewPhase(\"in_progress\", NewExecuteStep(runner, fetcher)),\n16\t//\t    NewPhase(\"ai_review\",  NewVerifyStep(checker)),\n17\t//\t)\n18\ttype Phase struct {\n19\t\tName  domain.TaskPhase\n20\t\tSteps []Step\n21\t}\n22\t\n23\t// NewPhase constructs a Phase. Variadic steps for ergonomics.\n24\tfunc NewPhase(name domain.TaskPhase, steps ...Step) Phase {\n25\t\treturn Phase{Name: name, Steps: steps}\n26\t}\n27\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"8f44f1af-9313-4b95-9163-58788982c0c9","timestamp":"2026-09-27T22:58:53.603Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
