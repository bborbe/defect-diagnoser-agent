{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8bbbfe2feb59ee42","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"context\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/bborbe/errors\"\n13\t\t\"gopkg.in/yaml.v3\"\n14\t)\n15\t\n16\t// Section is one heading-bounded block in a parsed markdown document.\n17\t//\n18\t// Heading is the exact heading line including '#' characters, e.g. \"## Plan\".\n19\t// Body is the content between this heading and the next at the same or\n20\t// higher level (no trailing newline).\n21\t//\n22\t// Section is the parsed structural unit. The CQRS BodySection (in\n23\t// lib/command/task) is a different concept: it carries the full\n24\t// serialized section text including the heading line, used as a partial\n25\t// frontmatter+body update payload.\n26\ttype Section struct {\n27\t\tHeading string\n28\t\tBody    string\n29\t}\n30\t\n31\t// Markdown is a parsed task document: frontmatter + preamble (text before\n32\t// the first section) + ordered list of sections.\n33\t//\n34\t// Steps mutate Markdown in place via the methods below. The framework\n35\t// re-serializes Markdown via Marshal after each step's Run and publishes\n36\t// the new content via the deliverer.\n37\ttype Markdown struct {\n38\t\tFrontmatter TaskFrontmatter\n39\t\tPreamble    string\n40\t\tSections    []Section\n41\t}\n42\t\n43\t// ParseMarkdown parses raw markdown into a Markdown document.\n44\t//\n45\t// Best-effort parsing: invalid YAML returns an empty Frontmatter without\n46\t// error. Sections are split at every \"# \" or \"## \" heading; \"### \" and\n47\t// deeper sub-headings are part of the parent section's Body.\n48\tfunc ParseMarkdown(_ context.Context, content string) (*Markdown, error) {\n49\t\tfmStr, body := splitMarkdownFrontmatter(content)\n50\t\tfm := parseMarkdownFrontmatter(fmStr)\n51\t\tpreamble, sections := splitMarkdownSections(body)\n52\t\treturn &Markdown{\n53\t\t\tFrontmatter: fm,\n54\t\t\tPreamble:    preamble,\n55\t\t\tSections:    sections,\n56\t\t}, nil\n57\t}\n58\t\n59\t// FindSection returns a pointer to the first section matching heading,\n60\t// and a bool indicating presence. Mutating the returned section's fields\n61\t// updates the Markdown in-place.\n62\tfunc (m *Markdown) FindSection(heading string) (*Section, bool) {\n63\t\tfor i := range m.Sections {\n64\t\t\tif m.Sections[i].Heading == heading {\n65\t\t\t\treturn &m.Sections[i], true\n66\t\t\t}\n67\t\t}\n68\t\treturn nil, false\n69\t}\n70\t\n71\t// AddSection appends a section to the end of the section list.\n72\t//\n73\t// Use ReplaceSection if a section with the same heading might already\n74\t// exist; AddSection does not deduplicate.\n75\tfunc (m *Markdown) AddSection(section Section) {\n76\t\tm.Sections = append(m.Sections, section)\n77\t}\n78\t\n79\t// ReplaceSection replaces the existing section with the same Heading,\n80\t// or appends if no match exists. Idempotent for \"save my output\" steps.\n81\tfunc (m *Markdown) ReplaceSection(section Section) {\n82\t\tfor i := range m.Sections {\n83\t\t\tif m.Sections[i].Heading == section.Heading {\n84\t\t\t\tm.Sections[i] = section\n85\t\t\t\treturn\n86\t\t\t}\n87\t\t}\n88\t\tm.Sections = append(m.Sections, section)\n89\t}\n90\t\n91\t// InsertSection inserts a section at the given position. Out-of-range\n92\t// positions clamp to [0, len(Sections)].\n93\tfunc (m *Markdown) InsertSection(pos int, section Section) {\n94\t\tif pos < 0 {\n95\t\t\tpos = 0\n96\t\t}\n97\t\tif pos > len(m.Sections) {\n98\t\t\tpos = len(m.Sections)\n99\t\t}\n100\t\tm.Sections = append(m.Sections[:pos], append([]Section{section}, m.Sections[pos:]...)...)\n101\t}\n102\t\n103\t// Marshal serializes the Markdown back to a markdown string.\n104\t//\n105\t// Output: \"---\\n<yaml>\\n---\\n<preamble><section><section>...\"\n106\t// Each section is rendered as \"<heading>\\n\\n<body>\\n\" if body is non-empty,\n107\t// or \"<heading>\\n\" if body is empty.\n108\tfunc (m *Markdown) Marshal(ctx context.Context) (string, error) {\n109\t\tvar b strings.Builder\n110\t\n111\t\tif len(m.Frontmatter) > 0 {\n112\t\t\tfmBytes, err := yaml.Marshal(map[string]any(m.Frontmatter))\n113\t\t\tif err != nil {\n114\t\t\t\treturn \"\", errors.Wrapf(ctx, err, \"marshal frontmatter\")\n115\t\t\t}\n116\t\t\tb.WriteString(\"---\\n\")\n117\t\t\tb.Write(fmBytes)\n118\t\t\tb.WriteString(\"---\\n\")\n119\t\t}\n120\t\n121\t\tif m.Preamble != \"\" {\n122\t\t\tb.WriteString(m.Preamble)\n123\t\t\tif !strings.HasSuffix(m.Preamble, \"\\n\") {\n124\t\t\t\tb.WriteString(\"\\n\")\n125\t\t\t}\n126\t\t}\n127\t\n128\t\tfor _, s := range m.Sections {\n129\t\t\tb.WriteString(s.Heading)\n130\t\t\tb.WriteString(\"\\n\")\n131\t\t\tif s.Body != \"\" {\n132\t\t\t\tb.WriteString(\"\\n\")\n133\t\t\t\tb.WriteString(s.Body)\n134\t\t\t\tif !strings.HasSuffix(s.Body, \"\\n\") {\n135\t\t\t\t\tb.WriteString(\"\\n\")\n136\t\t\t\t}\n137\t\t\t}\n138\t\t}\n139\t\n140\t\treturn b.String(), nil\n141\t}\n142\t\n143\t// splitMarkdownFrontmatter separates `---\\n<yaml>\\n---\\n<body>` into\n144\t// (yaml, body). If no frontmatter is present, returns (\"\", content).\n145\tfunc splitMarkdownFrontmatter(content string) (string, string) {\n146\t\tif !strings.HasPrefix(content, \"---\\n\") {\n147\t\t\treturn \"\", content\n148\t\t}\n149\t\trest := content[4:]\n150\t\tend := strings.Index(rest, \"\\n---\\n\")\n151\t\tif end < 0 {\n152\t\t\treturn \"\", content\n153\t\t}\n154\t\treturn rest[:end], rest[end+5:]\n155\t}\n156\t\n157\t// parseMarkdownFrontmatter parses YAML frontmatter; best-effort, returns\n158\t// an empty map on parse error.\n159\tfunc parseMarkdownFrontmatter(fm string) TaskFrontmatter {\n160\t\tout := TaskFrontmatter{}\n161\t\tif fm == \"\" {\n162\t\t\treturn out\n163\t\t}\n164\t\tif err := yaml.Unmarshal([]byte(fm), &out); err != nil {\n165\t\t\treturn TaskFrontmatter{}\n166\t\t}\n167\t\treturn out\n168\t}\n169\t\n170\t// splitMarkdownSections splits body content into preamble + sections at\n171\t// '# '/'## ' heading boundaries (level 1 or 2 headings start a new\n172\t// section; level 3+ stays inside the parent section).\n173\tfunc splitMarkdownSections(body string) (string, []Section) {\n174\t\tscanner := bufio.NewScanner(strings.NewReader(body))\n175\t\tscanner.Buffer(make([]byte, 1024*1024), 1024*1024)\n176\t\n177\t\tvar (\n178\t\t\tpreambleLines []string\n179\t\t\tsections      []Section\n180\t\t\tcurrentHead   string\n181\t\t\tcurrentBody   []string\n182\t\t\tinSection     bool\n183\t\t)\n184\t\n185\t\tflush := func() {\n186\t\t\tif !inSection {\n187\t\t\t\treturn\n188\t\t\t}\n189\t\t\tbody := strings.TrimSuffix(strings.Join(currentBody, \"\\n\"), \"\\n\")\n190\t\t\tsections = append(sections, Section{Heading: currentHead, Body: body})\n191\t\t\tcurrentHead = \"\"\n192\t\t\tcurrentBody = currentBody[:0]\n193\t\t}\n194\t\n195\t\tfor scanner.Scan() {\n196\t\t\tline := scanner.Text()\n197\t\t\tif isMarkdownSectionHeading(line) {\n198\t\t\t\tflush()\n199\t\t\t\tinSection = true\n200\t\t\t\tcurrentHead = line\n201\t\t\t\tcontinue\n202\t\t\t}\n203\t\t\tif !inSection {\n204\t\t\t\tpreambleLines = append(preambleLines, line)\n205\t\t\t\tcontinue\n206\t\t\t}\n207\t\t\tcurrentBody = append(currentBody, line)\n208\t\t}\n209\t\tflush()\n210\t\n211\t\tpreamble := strings.TrimSuffix(strings.Join(preambleLines, \"\\n\"), \"\\n\")\n212\t\treturn preamble, sections\n213\t}\n214\t\n215\t// isMarkdownSectionHeading returns true for \"# \" or \"## \" level headings.\n216\t// \"### \" and deeper stay inside their parent section.\n217\tfunc isMarkdownSectionHeading(line string) bool {\n218\t\tif !strings.HasPrefix(line, \"# \") && !strings.HasPrefix(line, \"## \") {\n219\t\t\treturn false\n220\t\t}\n221\t\tcount := 0\n222\t\tfor _, c := range line {\n223\t\t\tif c == '#' {\n224\t\t\t\tcount++\n225\t\t\t\tcontinue\n226\t\t\t}\n227\t\t\tbreak\n228\t\t}\n229\t\treturn (count == 1 || count == 2) && len(line) > count && line[count] == ' '\n230\t}\n231\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"7f2f076b-784b-48d5-87e3-58092ccdd1a0","timestamp":"2026-09-27T22:58:56.877Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9f8f06401968a526","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage lib\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\t\"github.com/bborbe/errors\"\n11\t)\n12\t\n13\t// StepRunner walks an ordered list of steps for a single phase invocation.\n14\t//\n15\t// On each iteration:\n16\t//  1. step.ShouldRun(markdown) — skip if false\n17\t//  2. step.Run(markdown) — mutates markdown in-place, returns Result\n18\t//  3. markdown.Marshal() → newContent\n19\t//  4. deliverer.DeliverResult(newContent, status, nextPhase)\n20\t//  5. Decides whether to continue based on Status, NextPhase, ContinueToNext\n21\t//\n22\t// Resume semantics: the runner does NOT track \"current step\" state. On\n23\t// re-invocation, all steps are re-walked; their ShouldRun guards skip\n24\t// completed work based on saved markdown state. Markdown state IS the\n25\t// resume cursor.\n26\ttype StepRunner struct {\n27\t\tsteps     []Step\n28\t\tdeliverer ResultDeliverer\n29\t}\n30\t\n31\t// NewStepRunner constructs a StepRunner with the given step list and deliverer.\n32\tfunc NewStepRunner(deliverer ResultDeliverer, steps ...Step) *StepRunner {\n33\t\treturn &StepRunner{steps: steps, deliverer: deliverer}\n34\t}\n35\t\n36\t// Run walks the step list, calling guards, running, marshaling, and saving.\n37\t// Returns the last delivered Result, or nil if no step executed.\n38\tfunc (r *StepRunner) Run(ctx context.Context, md *Markdown) (*Result, error) {\n39\t\tvar lastResult *Result\n40\t\n41\t\tfor _, s := range r.steps {\n42\t\t\tselect {\n43\t\t\tcase <-ctx.Done():\n44\t\t\t\treturn nil, ctx.Err()\n45\t\t\tdefault:\n46\t\t\t}\n47\t\n48\t\t\tshouldRun, err := s.ShouldRun(ctx, md)\n49\t\t\tif err != nil {\n50\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"step %q ShouldRun\", s.Name())\n51\t\t\t}\n52\t\t\tif !shouldRun {\n53\t\t\t\tcontinue\n54\t\t\t}\n55\t\n56\t\t\tresult, err := s.Run(ctx, md)\n57\t\t\tif err != nil {\n58\t\t\t\treturn nil, errors.Wrapf(ctx, err, \"step %q Run\", s.Name())\n59\t\t\t}\n60\t\t\tif result == nil {\n61\t\t\t\treturn nil, errors.Errorf(ctx, \"step %q returned nil result\", s.Name())\n62\t\t\t}\n63\t\n64\t\t\t// Re-serialize the (possibly mutated) markdown and publish.\n65\t\t\tnewContent, err := md.Marshal(ctx)\n66\t\t\tif err != nil {\n67\t\t\t\treturn result, errors.Wrapf(ctx, err, \"step %q marshal markdown\", s.Name())\n68\t\t\t}\n69\t\n70\t\t\tif err := r.deliverer.DeliverResult(ctx, AgentResultInfo{\n71\t\t\t\tStatus:           result.Status,\n72\t\t\t\tOutput:           newContent,\n73\t\t\t\tMessage:          result.Message,\n74\t\t\t\tNextPhase:        result.NextPhase,\n75\t\t\t\tContinueToNext:   result.ContinueToNext,\n76\t\t\t\tAgentTurns:       result.AgentTurns,\n77\t\t\t\tInteractionCount: result.InteractionCount,\n78\t\t\t}); err != nil {\n79\t\t\t\treturn result, errors.Wrapf(ctx, err, \"step %q deliver\", s.Name())\n80\t\t\t}\n81\t\n82\t\t\tlastResult = result\n83\t\n84\t\t\tif shouldExitStepRunner(*result) {\n85\t\t\t\tbreak\n86\t\t\t}\n87\t\t}\n88\t\n89\t\tif ctx.Err() != nil {\n90\t\t\treturn nil, ctx.Err()\n91\t\t}\n92\t\treturn lastResult, nil\n93\t}\n94\t\n95\t// shouldExitStepRunner returns true if the StepRunner should stop after\n96\t// delivering result.\n97\tfunc shouldExitStepRunner(r Result) bool {\n98\t\tswitch r.Status {\n99\t\tcase AgentStatusFailed, AgentStatusNeedsInput:\n100\t\t\treturn true\n101\t\tcase AgentStatusDone:\n102\t\t\t// Done with NextPhase advances — exit Job, controller spawns next phase.\n103\t\t\t// Done without NextPhase is in-place save; continue iff ContinueToNext.\n104\t\t\tif r.NextPhase != \"\" {\n105\t\t\t\treturn true\n106\t\t\t}\n107\t\t\treturn !r.ContinueToNext\n108\t\tcase AgentStatusInProgress:\n109\t\t\t// In-place save: continue iff explicitly requested.\n110\t\t\treturn !r.ContinueToNext\n111\t\t}\n112\t\treturn true\n113\t}\n114\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"055f5c16-46a5-48d5-8c6f-670658b9bb64","timestamp":"2026-09-27T22:58:56.878Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
