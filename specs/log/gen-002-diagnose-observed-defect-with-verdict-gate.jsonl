{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9bad8874abd79422","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage claude\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"bytes\"\n10\t\t\"context\"\n11\t\t\"encoding/json\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/bborbe/collection\"\n17\t\t\"github.com/bborbe/errors\"\n18\t\t\"github.com/golang/glog\"\n19\t\n20\t\t\"github.com/bborbe/agent/envparse\"\n21\t)\n22\t\n23\tconst (\n24\t\ttailMaxLines = 5\n25\t\ttailMaxBytes = 512\n26\t\ttailJoiner   = \" | \"\n27\t)\n28\t\n29\t// partialMaxBytes caps the partial captured from the claude CLI stream: at most this\n30\t// many of the most recent bytes of streamed assistant text are kept. It is a frozen\n31\t// package constant (spec 049): a cap that can be disabled is an escape hatch on the\n32\t// salvage feature, so it is deliberately NOT configurable.\n33\tconst partialMaxBytes = 16384\n34\t\n35\t//counterfeiter:generate -o ../mocks/claude-claude-runner.go --fake-name ClaudeRunner . ClaudeRunner\n36\t\n37\t// ClaudeRunner spawns a headless Claude Code CLI session with a prompt and MCP tools.\n38\ttype ClaudeRunner interface {\n39\t\tRun(ctx context.Context, prompt string) (*ClaudeResult, error)\n40\t}\n41\t\n42\t// NewClaudeRunner creates a ClaudeRunner that spawns claude --print with MCP tools.\n43\tfunc NewClaudeRunner(config ClaudeRunnerConfig) ClaudeRunner {\n44\t\treturn &claudeRunner{\n45\t\t\tconfig: config,\n46\t\t}\n47\t}\n48\t\n49\ttype claudeRunner struct {\n50\t\tconfig ClaudeRunnerConfig\n51\t}\n52\t\n53\tfunc (r *claudeRunner) Run(ctx context.Context, prompt string) (*ClaudeResult, error) {\n54\t\tcmd, err := r.buildCommand(ctx, prompt)\n55\t\tif err != nil {\n56\t\t\treturn nil, errors.Wrap(ctx, err, \"build command\")\n57\t\t}\n58\t\n59\t\tstdoutPipe, err := cmd.StdoutPipe()\n60\t\tif err != nil {\n61\t\t\treturn nil, errors.Wrap(ctx, err, \"create stdout pipe\")\n62\t\t}\n63\t\n64\t\tif err := cmd.Start(); err != nil {\n65\t\t\treturn nil, errors.Wrap(ctx, err, \"start claude CLI\")\n66\t\t}\n67\t\n68\t\tresultText, usage, partial, tail, sessionID := scanOutput(ctx, stdoutPipe)\n69\t\n70\t\tif err := cmd.Wait(); err != nil {\n71\t\t\tvar tailMsg string\n72\t\t\tif len(tail) > 0 {\n73\t\t\t\ttailMsg = strings.Join(tail, tailJoiner)\n74\t\t\t} else {\n75\t\t\t\ttailMsg = \"no stdout captured\"\n76\t\t\t}\n77\t\t\treturn &ClaudeResult{\n78\t\t\t\tPartial: partial,\n79\t\t\t}, errors.Wrapf(ctx, err, \"claude CLI failed: %s\", tailMsg)\n80\t\t}\n81\t\n82\t\tif resultText == \"\" {\n83\t\t\treturn &ClaudeResult{\n84\t\t\t\tPartial: partial,\n85\t\t\t}, errors.New(ctx, \"no result event found in claude CLI output\")\n86\t\t}\n87\t\n88\t\treturn &ClaudeResult{\n89\t\t\tResult:              resultText,\n90\t\t\tPartial:             partial,\n91\t\t\tInputTokens:         usage.inputTokens,\n92\t\t\tOutputTokens:        usage.outputTokens,\n93\t\t\tCacheCreationTokens: usage.cacheCreationTokens,\n94\t\t\tCacheReadTokens:     usage.cacheReadTokens,\n95\t\t\tNumTurns:            usage.numTurns,\n96\t\t\tSessionID:           sessionID,\n97\t\t\tInteractionCount:    r.countHumanInteractions(ctx, sessionID),\n98\t\t}, nil\n99\t}\n100\t\n101\t// resolveConfigDir returns the Claude config directory the CLI subprocess is given,\n102\t// applying the same precedence buildSubprocessEnv applies: explicit config > parent\n103\t// process env > default \"~/.claude\", with a consumer-provided Env override winning.\n104\tfunc (r *claudeRunner) resolveConfigDir(ctx context.Context) (string, error) {\n105\t\tcfgDir := r.config.ClaudeConfigDir\n106\t\tif cfgDir == \"\" {\n107\t\t\tif envVal := os.Getenv(\"CLAUDE_CONFIG_DIR\"); envVal != \"\" {\n108\t\t\t\tcfgDir = ClaudeConfigDir(envVal)\n109\t\t\t}\n110\t\t}\n111\t\tif cfgDir == \"\" {\n112\t\t\tcfgDir = \"~/.claude\"\n113\t\t}\n114\t\t// The highest-precedence layer of buildSubprocessEnv: a consumer-provided Env\n115\t\t// override. The transcript is written where the CLI was told to write it, so the\n116\t\t// scan follows the same value. (For an override containing \"~\" the subprocess gets\n117\t\t// the literal string while this resolves it; the scan then finds no transcript and\n118\t\t// the count stays absent — never wrong.)\n119\t\tif override, ok := r.config.Env[\"CLAUDE_CONFIG_DIR\"]; ok && override != \"\" {\n120\t\t\tcfgDir = ClaudeConfigDir(override)\n121\t\t}\n122\t\tresolved, err := cfgDir.Resolve(ctx)\n123\t\tif err != nil {\n124\t\t\treturn \"\", errors.Wrap(ctx, err, \"resolve ClaudeConfigDir\")\n125\t\t}\n126\t\treturn resolved, nil\n127\t}\n128\t\n129\t// countHumanInteractions resolves the Claude config directory and counts the\n130\t// human-authored entries in the session's own transcript. It returns nil — never a\n131\t// zero — when the evidence is unavailable: no session id, an unresolvable config\n132\t// directory, or a transcript that cannot be located, read, or parsed.\n133\tfunc (r *claudeRunner) countHumanInteractions(ctx context.Context, sessionID string) *int64 {\n134\t\tif sessionID == \"\" {\n135\t\t\treturn nil\n136\t\t}\n137\t\tconfigDir, err := r.resolveConfigDir(ctx)\n138\t\tif err != nil {\n139\t\t\treturn nil\n140\t\t}\n141\t\tcount, ok := countHumanAuthoredEntries(ctx, ClaudeConfigDir(configDir), sessionID)\n142\t\tif !ok {\n143\t\t\treturn nil\n144\t\t}\n145\t\treturn collection.Ptr(count)\n146\t}\n147\t\n148\tfunc (r *claudeRunner) buildCommand(\n149\t\tctx context.Context,\n150\t\tprompt string,\n151\t) (*exec.Cmd, error) {\n152\t\targs := []string{\n153\t\t\t\"--print\",\n154\t\t\t\"--output-format\", \"stream-json\",\n155\t\t\t\"--verbose\",\n156\t\t\t\"--strict-mcp-config\",\n157\t\t}\n158\t\n159\t\tif len(r.config.AllowedTools) > 0 {\n160\t\t\targs = append(args, \"--allowedTools\", r.config.AllowedTools.String())\n161\t\t}\n162\t\n163\t\tif r.config.Model != \"\" {\n164\t\t\targs = append(args, \"--model\", r.config.Model.String())\n165\t\t}\n166\t\n167\t\tglog.V(2).Infof(\"spawning claude CLI: claude %v\", args)\n168\t\n169\t\tcmd := exec.CommandContext(ctx, \"claude\", args...)\n170\t\tif r.config.WorkingDirectory != \"\" {\n171\t\t\tworkDir, err := r.config.WorkingDirectory.Resolve(ctx)\n172\t\t\tif err != nil {\n173\t\t\t\treturn nil, errors.Wrap(ctx, err, \"resolve WorkingDirectory\")\n174\t\t\t}\n175\t\t\tcmd.Dir = workDir\n176\t\t\tglog.V(2).Infof(\"cmd.Dir = %v\", cmd.Dir)\n177\t\t}\n178\t\n179\t\tcmd.Stdin = bytes.NewBufferString(prompt)\n180\t\tglog.V(3).Infof(\"cmd.Stdin = %v\", prompt)\n181\t\n182\t\tenv, err := r.buildSubprocessEnv(ctx)\n183\t\tif err != nil {\n184\t\t\treturn nil, errors.Wrap(ctx, err, \"build subprocess env\")\n185\t\t}\n186\t\tcmd.Env = env\n187\t\tglog.V(2).Infof(\"cmd.Env = %+v\", envparse.RedactForLog(cmd.Env))\n188\t\n189\t\treturn cmd, nil\n190\t}\n191\t\n192\t// appendTail appends a non-empty line to the ring buffer, truncating to tailMaxBytes and evicting the oldest entry when over tailMaxLines.\n193\tfunc appendTail(tail []string, line []byte) []string {\n194\t\tif len(line) == 0 {\n195\t\t\treturn tail\n196\t\t}\n197\t\tcaptured := line\n198\t\tif len(captured) > tailMaxBytes {\n199\t\t\tcaptured = captured[:tailMaxBytes]\n200\t\t}\n201\t\ttail = append(tail, string(captured))\n202\t\tif len(tail) > tailMaxLines {\n203\t\t\ttail = tail[len(tail)-tailMaxLines:]\n204\t\t}\n205\t\treturn tail\n206\t}\n207\t\n208\t// appendPartial appends chunk to the bounded partial buffer, keeping at most\n209\t// partialMaxBytes of the most recent bytes and dropping the earliest bytes on\n210\t// overflow.\n211\t//\n212\t// The simple slice-copy is deliberate: the buffer is capped at 16 KiB and\n213\t// cleared on every run, so the O(n) copy on overflow is bounded and trivial\n214\t// (~microseconds); a ring-buffer would add head-index bookkeeping for no\n215\t// measurable gain at this size.\n216\tfunc appendPartial(partial []byte, chunk string) []byte {\n217\t\tpartial = append(partial, chunk...)\n218\t\tif len(partial) > partialMaxBytes {\n219\t\t\tpartial = partial[len(partial)-partialMaxBytes:]\n220\t\t}\n221\t\treturn partial\n222\t}\n223\t\n224\t// capturePartial appends the plain text content of an assistant event to the\n225\t// bounded partial buffer. Tool payloads (tool_use items carry their payload in\n226\t// Input, not Text), usage telemetry, and the stream-json envelope itself are\n227\t// excluded. On event-schema drift the gate degrades to a no-op without crashing.\n228\tfunc capturePartial(partial []byte, event claudeEvent) []byte {\n229\t\tif event.Type == \"assistant\" {\n230\t\t\tfor _, c := range event.Message.Content {\n231\t\t\t\tif c.Type == \"text\" {\n232\t\t\t\t\tpartial = appendPartial(partial, c.Text)\n233\t\t\t\t}\n234\t\t\t}\n235\t\t}\n236\t\treturn partial\n237\t}\n238\t\n239\t// parseUsage extracts token counts from a raw usage JSON block and the num_turns field\n240\t// from the parent event. Each token field is unmarshalled individually from a map so that a\n241\t// decode error on one field does not roll back valid values from other fields.\n242\t// Malformed values degrade to 0 without error, per the best-effort telemetry contract.\n243\tfunc parseUsage(usageRaw json.RawMessage, numTurns json.Number) sessionUsage {\n244\t\tvar usage sessionUsage\n245\t\tvar usageMap map[string]json.RawMessage\n246\t\tif err := json.Unmarshal(usageRaw, &usageMap); err != nil {\n247\t\t\treturn usage\n248\t\t}\n249\t\n250\t\tvar inputTokens, outputTokens, cacheCreationTokens, cacheReadTokens json.Number\n251\t\n252\t\t//nolint:errcheck // Intentional: malformed fields degrade to 0, which is the correct behaviour.\n253\t\tif v, ok := usageMap[\"input_tokens\"]; ok {\n254\t\t\tjson.Unmarshal(v, &inputTokens)\n255\t\t}\n256\t\t//nolint:errcheck\n257\t\tif v, ok := usageMap[\"output_tokens\"]; ok {\n258\t\t\tjson.Unmarshal(v, &outputTokens)\n259\t\t}\n260\t\t//nolint:errcheck\n261\t\tif v, ok := usageMap[\"cache_creation_input_tokens\"]; ok {\n262\t\t\tjson.Unmarshal(v, &cacheCreationTokens)\n263\t\t}\n264\t\t//nolint:errcheck\n265\t\tif v, ok := usageMap[\"cache_read_input_tokens\"]; ok {\n266\t\t\tjson.Unmarshal(v, &cacheReadTokens)\n267\t\t}\n268\t\n269\t\tusage.inputTokens = numberToInt64(inputTokens)\n270\t\tusage.outputTokens = numberToInt64(outputTokens)\n271\t\tusage.cacheCreationTokens = numberToInt64(cacheCreationTokens)\n272\t\tusage.cacheReadTokens = numberToInt64(cacheReadTokens)\n273\t\tusage.numTurns = numberToInt64(numTurns)\n274\t\treturn usage\n275\t}\n276\t\n277\t// scanOutput reads stream-json lines from stdout, logs events, and returns the result\n278\t// text, the captured usage summary, the bounded partial of streamed assistant text,\n279\t// a bounded tail of all non-empty lines, and the session id the stream reported.\n280\tfunc scanOutput(\n281\t\tctx context.Context,\n282\t\treader interface{ Read([]byte) (int, error) },\n283\t) (string, sessionUsage, string, []string, string) {\n284\t\tvar resultText string\n285\t\tvar sessionID string\n286\t\tvar usage sessionUsage\n287\t\tvar partial []byte\n288\t\tvar tail []string\n289\t\tscanner := bufio.NewScanner(reader)\n290\t\tscanner.Buffer(make([]byte, 0, 1024*1024), 10*1024*1024)\n291\t\tfor scanner.Scan() {\n292\t\t\tselect {\n293\t\t\tcase <-ctx.Done():\n294\t\t\t\treturn resultText, usage, string(partial), tail, sessionID\n295\t\t\tdefault:\n296\t\t\t}\n297\t\n298\t\t\tline := scanner.Bytes()\n299\t\t\tglog.V(4).Infof(\"[line] %s\", line)\n300\t\n301\t\t\ttail = appendTail(tail, line)\n302\t\n303\t\t\t// Two-pass unmarshal: first extract type/result safely (never fails on schema issues),\n304\t\t\t// then attempt full unmarshal for usage fields (may fail on e.g. json.Number receiving\n305\t\t\t// a string). The first pass always succeeds for syntactically valid JSON, ensuring\n306\t\t\t// resultText survives schema drift in the usage subtree.\n307\t\t\tvar holder resultHolder\n308\t\t\tif err := json.Unmarshal(line, &holder); err != nil {\n309\t\t\t\tcontinue\n310\t\t\t}\n311\t\n312\t\t\tif holder.Type == \"result\" && holder.Result != \"\" {\n313\t\t\t\tresultText = holder.Result\n314\t\t\t}\n315\t\n316\t\t\t// Full unmarshal: may fail due to schema-level issues in usage fields.\n317\t\t\t// On failure we still keep the resultText captured above.\n318\t\t\tvar event claudeEvent\n319\t\t\tif err := json.Unmarshal(line, &event); err != nil {\n320\t\t\t\tcontinue\n321\t\t\t}\n322\t\n323\t\t\t// Usage capture is deliberately gated on the presence of a usage object, NOT\n324\t\t\t// on a non-empty result text: a later result event carrying fresh usage but an\n325\t\t\t// empty result string must update the numbers while leaving the previously\n326\t\t\t// captured text intact. Last usage object wins.\n327\t\t\tif event.Type == \"result\" && len(event.Usage) > 0 {\n328\t\t\t\tusage = parseUsage(event.Usage, event.NumTurns)\n329\t\t\t}\n330\t\n331\t\t\t// Last non-empty session id wins, exactly like the usage summary. Not gated\n332\t\t\t// on the result event: the init event carries the id too.\n333\t\t\tif event.SessionID != \"\" {\n334\t\t\t\tsessionID = event.SessionID\n335\t\t\t}\n336\t\n337\t\t\tpartial = capturePartial(partial, event)\n338\t\n339\t\t\tfor _, c := range event.Message.Content {\n340\t\t\t\tswitch c.Type {\n341\t\t\t\tcase \"tool_use\":\n342\t\t\t\t\tlogToolUse(c)\n343\t\t\t\tdefault:\n344\t\t\t\t\tglog.V(2).Infof(\"type(%s): %s\", c.Type, c.Text)\n345\t\t\t\t}\n346\t\t\t}\n347\t\t}\n348\t\treturn resultText, usage, string(partial), tail, sessionID\n349\t}\n350\t\n351\t// buildSubprocessEnv constructs the env var slice for the Claude CLI subprocess.\n352\t// Precedence (later layers override earlier):\n353\t//\n354\t//  1. Allowlist: pass-through of safe parent-process vars (HOME, PATH, ...).\n355\t//     The parent process (task executor) typically runs with secrets, Kafka creds,\n356\t//     and other sensitive vars in its environment; we do NOT want those flowing into\n357\t//     Claude sessions by default. This allowlist enforces that trust boundary — only\n358\t//     well-known, non-sensitive vars pass through automatically.\n359\t//  2. CLAUDE_CONFIG_DIR: explicit config > parent process env > default \"~/.claude\".\n360\t//  3. Consumer-provided r.config.Env: arbitrary overrides — highest precedence.\n361\t//     To pass additional vars (e.g. GH_TOKEN for gh CLI auth), populate\n362\t//     ClaudeRunnerConfig.Env. Values here cross the trust boundary into the\n363\t//     Claude CLI subprocess — only add what the agent genuinely needs.\n364\t//\n365\t// Building via map[string]string makes precedence linear by assignment order and\n366\t// prevents duplicate-key entries in the resulting []string.\n367\tfunc (r *claudeRunner) buildSubprocessEnv(ctx context.Context) ([]string, error) {\n368\t\tenv := map[string]string{}\n369\t\n370\t\t// Layer 1: allowlist pass-through.\n371\t\tfor _, k := range []string{\"HOME\", \"PATH\", \"USER\", \"TZ\", \"ZONEINFO\", \"TMPDIR\", \"LANG\", \"LC_ALL\"} {\n372\t\t\tif v, ok := os.LookupEnv(k); ok {\n373\t\t\t\tenv[k] = v\n374\t\t\t}\n375\t\t}\n376\t\n377\t\t// Layer 2: CLAUDE_CONFIG_DIR with precedence config > env > default.\n378\t\tresolved, err := r.resolveConfigDir(ctx)\n379\t\tif err != nil {\n380\t\t\treturn nil, err\n381\t\t}\n382\t\tenv[\"CLAUDE_CONFIG_DIR\"] = resolved\n383\t\n384\t\t// Layer 3: consumer-provided env overrides everything above.\n385\t\tfor k, v := range r.config.Env {\n386\t\t\tenv[k] = v\n387\t\t}\n388\t\n389\t\t// Convert to []string for exec.Cmd.\n390\t\tresult := make([]string, 0, len(env))\n391\t\tfor k, v := range env {\n392\t\t\tresult = append(result, k+\"=\"+v)\n393\t\t}\n394\t\treturn result, nil\n395\t}\n396\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"bda7c237-47bc-4592-b3de-911a84432021","timestamp":"2026-09-27T22:59:38.310Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ba572702a217b624","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage claude\n6\t\n7\timport (\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t)\n11\t\n12\t// BuildPrompt combines instructions with environment context and task content.\n13\tfunc BuildPrompt(\n14\t\tinstructions string,\n15\t\tenvContext map[string]string,\n16\t\ttaskContent string,\n17\t) string {\n18\t\tvar sb strings.Builder\n19\t\tsb.WriteString(instructions)\n20\t\n21\t\tif len(envContext) > 0 {\n22\t\t\tsb.WriteString(\"\\n\\n## Environment\\n\\n\")\n23\t\t\tkeys := make([]string, 0, len(envContext))\n24\t\t\tfor k := range envContext {\n25\t\t\t\tkeys = append(keys, k)\n26\t\t\t}\n27\t\t\tsort.Strings(keys)\n28\t\t\tfor _, k := range keys {\n29\t\t\t\tsb.WriteString(k)\n30\t\t\t\tsb.WriteString(\": \")\n31\t\t\t\tsb.WriteString(envContext[k])\n32\t\t\t\tsb.WriteString(\"\\n\")\n33\t\t\t}\n34\t\t}\n35\t\n36\t\tsb.WriteString(\"\\n\\n## Task\\n\\n\")\n37\t\tsb.WriteString(taskContent)\n38\t\treturn sb.String()\n39\t}\n40\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"024a2aa1-670b-40a1-8118-dad800b7767b","timestamp":"2026-09-27T22:59:38.311Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bc671202f296b1f1","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage claude\n6\t\n7\t// ClaudeResult holds the parsed output from a Claude Code CLI session.\n8\ttype ClaudeResult struct {\n9\t\tResult string `json:\"result\"`\n10\t\t// Partial is the assistant text the CLI streamed before the run ended, bounded\n11\t\t// to the most recent 16 KiB. Empty when the CLI streamed no assistant text.\n12\t\tPartial string `json:\"partial,omitempty\"`\n13\t\t// InputTokens is the count of fresh (non-cached) input tokens the session consumed.\n14\t\tInputTokens int64 `json:\"input_tokens,omitempty\"`\n15\t\t// OutputTokens is the count of output tokens the session produced.\n16\t\tOutputTokens int64 `json:\"output_tokens,omitempty\"`\n17\t\t// CacheCreationTokens is the count of input tokens written into the prompt cache.\n18\t\tCacheCreationTokens int64 `json:\"cache_creation_tokens,omitempty\"`\n19\t\t// CacheReadTokens is the count of input tokens served from the prompt cache.\n20\t\tCacheReadTokens int64 `json:\"cache_read_input_tokens,omitempty\"`\n21\t\t// NumTurns is the number of conversation turns the session took. Zero when the\n22\t\t// CLI reported no usage summary.\n23\t\tNumTurns int64 `json:\"num_turns,omitempty\"`\n24\t\t// SessionID is the CLI session identifier the stream reported. Empty when the CLI\n25\t\t// reported no session id.\n26\t\tSessionID string `json:\"session_id,omitempty\"`\n27\t\t// InteractionCount is the number of human-authored entries the session's own\n28\t\t// transcript recorded. Nil when the evidence was unavailable — no session id, no\n29\t\t// transcript, or an unreadable or unparseable transcript. A non-nil zero is an\n30\t\t// observation: the transcript was read and contained no hu