{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8d2953dcd63c561e","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage delivery\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"strings\"\n10\t\n11\t\tagentlib \"github.com/bborbe/agent\"\n12\t)\n13\t\n14\t//counterfeiter:generate -o ../mocks/delivery-content-generator.go --fake-name AgentContentGenerator . ContentGenerator\n15\t\n16\t// ContentGenerator produces a complete updated task markdown document from the original content and agent result.\n17\t// The returned string must be valid markdown with YAML frontmatter.\n18\ttype ContentGenerator interface {\n19\t\tGenerate(\n20\t\t\tctx context.Context,\n21\t\t\toriginalContent string,\n22\t\t\tresult agentlib.AgentResultInfo,\n23\t\t) (string, error)\n24\t}\n25\t\n26\t// NewFallbackContentGenerator creates a ContentGenerator that uses deterministic string concatenation.\n27\tfunc NewFallbackContentGenerator() ContentGenerator {\n28\t\treturn &fallbackContentGenerator{}\n29\t}\n30\t\n31\ttype fallbackContentGenerator struct{}\n32\t\n33\tfunc (g *fallbackContentGenerator) Generate(\n34\t\t_ context.Context,\n35\t\toriginalContent string,\n36\t\tresult agentlib.AgentResultInfo,\n37\t) (string, error) {\n38\t\tupdated := applyStatusFrontmatter(originalContent, result)\n39\t\tif result.Status == agentlib.AgentStatusFailed {\n40\t\t\tsection := buildFailureSection(result)\n41\t\t\treturn ReplaceOrAppendSection(updated, \"## Failure\", section), nil\n42\t\t}\n43\t\tsection := result.Output\n44\t\tif section == \"\" {\n45\t\t\tsection = buildMinimalResultSection(result)\n46\t\t}\n47\t\treturn ReplaceOrAppendSection(updated, \"## Result\", section), nil\n48\t}\n49\t\n50\t// applyStatusFrontmatter updates status+phase frontmatter fields based on agent result\n51\t// status and requested NextPhase.\n52\tfunc applyStatusFrontmatter(content string, result agentlib.AgentResultInfo) string {\n53\t\tswitch result.Status {\n54\t\tcase agentlib.AgentStatusDone:\n55\t\t\tif result.NextPhase == \"\" {\n56\t\t\t\t// Done without NextPhase is an in-place save (see agentlib.Result.NextPhase:\n57\t\t\t\t// \"Empty means stay in current phase\"): keep status: in_progress, preserve\n58\t\t\t\t// phase from existing content. Terminating a task requires an explicit\n59\t\t\t\t// NextPhase: \"done\".\n60\t\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n61\t\t\t\t// phase intentionally not modified — preserves the current phase\n62\t\t\t\tbreak\n63\t\t\t}\n64\t\t\tresolvedPhase := resolveNextPhase(\"\", result.NextPhase)\n65\t\t\tcontent = SetFrontmatterField(content, \"phase\", resolvedPhase)\n66\t\t\t// Only mark the task completed when the resolved phase is terminal (done) —\n67\t\t\t// mirrors the kafkaResultDeliverer frontmatter override.\n68\t\t\tif resolvedPhase == \"done\" {\n69\t\t\t\tcontent = SetFrontmatterField(content, \"status\", \"completed\")\n70\t\t\t} else {\n71\t\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n72\t\t\t}\n73\t\tcase agentlib.AgentStatusNeedsInput:\n74\t\t\t// task-level failure: agent ran cleanly but task is impossible/underspecified.\n75\t\t\t// Clear assignee so the task surfaces in the operator inbox; record the pre-clear\n76\t\t\t// owner (spec 027); preserve phase — human_review is reserved for Result.NextPhase.\n77\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n78\t\t\tif prev := getFrontmatterField(content, \"assignee\"); prev != \"\" {\n79\t\t\t\tcontent = SetFrontmatterField(content, \"previous_assignee\", prev)\n80\t\t\t}\n81\t\t\tcontent = SetFrontmatterField(content, \"assignee\", \"\")\n82\t\t\t// phase is preserved from existing content — do NOT set to human_review\n83\t\tcase agentlib.AgentStatusInProgress:\n84\t\t\t// Step-level progress save: keep status: in_progress, preserve phase from incoming task.\n85\t\t\t// Multi-step phase handlers use this to commit ## Plan / ## Result / etc. mid-phase\n86\t\t\t// without triggering a phase transition.\n87\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n88\t\t\t// phase intentionally not modified — preserves the agent's current phase for in-place save\n89\t\tcase agentlib.AgentStatusFailed:\n90\t\t\t// Infra failure (transient — crash, timeout, OOM): preserve assignee so the task\n91\t\t\t// stays routable and trigger_count / max_triggers retries can fire. At cap\n92\t\t\t// exhaustion the task escalates to the operator inbox: assignee cleared,\n93\t\t\t// previous_assignee recorded (spec 027), phase as the resume cursor.\n94\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n95\t\t\tif triggerCountAtCap(content) {\n96\t\t\t\tif prev := getFrontmatterField(content, \"assignee\"); prev != \"\" {\n97\t\t\t\t\tcontent = SetFrontmatterField(content, \"previous_assignee\", prev)\n98\t\t\t\t}\n99\t\t\t\tcontent = SetFrontmatterField(content, \"assignee\", \"\")\n100\t\t\t}\n101\t\t\t// phase is preserved from existing content — do NOT set to human_review\n102\t\tdefault:\n103\t\t\t// Unknown status: defensive — surface to the operator like a cap exhaustion.\n104\t\t\tcontent = SetFrontmatterField(content, \"status\", \"in_progress\")\n105\t\t\tcontent = SetFrontmatterField(content, \"assignee\", \"\")\n106\t\t\t// phase is preserved from existing content — do NOT set to human_review\n107\t\t}\n108\t\treturn content\n109\t}\n110\t\n111\t// triggerCountAtCap reports whether the task's trigger_count has reached its\n112\t// max_triggers budget. Used by the failed-result path to decide retry (assignee\n113\t// preserved) vs escalation (assignee cleared, previous_assignee recorded).\n114\tfunc triggerCountAtCap(content string) bool {\n115\t\tfm, _ := ParseMarkdownFrontmatter(content)\n116\t\tfrontmatter := agentlib.TaskFrontmatter{}\n117\t\tfor k, v := range fm {\n118\t\t\tfrontmatter[k] = v\n119\t\t}\n120\t\treturn frontmatter.TriggerCount() >= frontmatter.MaxTriggers()\n121\t}\n122\t\n123\t// getFrontmatterField reads a string field from YAML frontmatter.\n124\t// Returns \"\" when the field is absent or holds a non-string value.\n125\tfunc getFrontmatterField(content, key string) string {\n126\t\tfm, _ := ParseMarkdownFrontmatter(content)\n127\t\tv, _ := fm[key].(string)\n128\t\treturn v\n129\t}\n130\t\n131\t// buildFailureSection renders a `## Failure` block with a human-readable\n132\t// reason extracted from the agent's result. Used when the agent returns\n133\t// status: failed — symmetric with PublishFailure's K8s-crash failure path.\n134\tfunc buildFailureSection(result agentlib.AgentResultInfo) string {\n135\t\tvar b strings.Builder\n136\t\tb.WriteString(\"## Failure\\n\\n\")\n137\t\tif result.Message != \"\" {\n138\t\t\tb.WriteString(\"- **Reason:**\\n\\n\")\n139\t\t\tb.WriteString(\"```\\n\")\n140\t\t\tb.WriteString(result.Message)\n141\t\t\tb.WriteString(\"\\n```\\n\")\n142\t\t} else {\n143\t\t\tb.WriteString(\"- **Reason:** agent returned status: failed (no message provided)\\n\")\n144\t\t}\n145\t\treturn b.String()\n146\t}\n147\t\n148\t// buildMinimalResultSection renders a fallback ## Result block when agentlib.AgentResultInfo.Output is empty.\n149\t// Callers that supply a non-empty Output are trusted to provide the full section verbatim.\n150\tfunc buildMinimalResultSection(result agentlib.AgentResultInfo) string {\n151\t\tvar b strings.Builder\n152\t\tb.WriteString(\"## Result\\n\\n\")\n153\t\tb.WriteString(\"**Status:** \")\n154\t\tb.WriteString(string(result.Status))\n155\t\tb.WriteString(\"\\n\")\n156\t\tif result.Message != \"\" {\n157\t\t\tb.WriteString(\"**Message:** \")\n158\t\t\tb.WriteString(result.Message)\n159\t\t\tb.WriteString(\"\\n\")\n160\t\t}\n161\t\treturn b.String()\n162\t}\n163\t\n164\t// NewPassthroughContentGenerator creates a ContentGenerator that returns\n165\t// result.Output verbatim (with status/phase frontmatter applied on top).\n166\t//\n167\t// Used by the new agent framework (lib.NewAgent / lib.StepRunner): the\n168\t// step mutates a parsed Markdown via task.AddSection / ReplaceSection and\n169\t// the runner re-serializes the full task into result.Output. The deliverer\n170\t// must NOT splice the output into a \"## Result\" section — it must publish\n171\t// the agent-produced content directly.\n172\t//\n173\t// Status/phase frontmatter is still applied here so file delivery sets\n174\t// status: completed / phase: done on success (Done + explicit NextPhase:\n175\t// \"done\") without each agent having to mutate the frontmatter map manually;\n176\t// Done without NextPhase is an in-place save that leaves the phase untouched.\n177\t// The Kafka deliverer overrides status/phase again after this generator runs\n178\t// (same end state).\n179\t//\n180\t// On AgentStatusFailed or AgentStatusNeedsInput, the passthrough generator\n181\t// splices a ## Failure section into result.Output so operators always see the\n182\t// failure reason — without this, early-step failures (where Output is empty)\n183\t// leave a body-less task. Mirrors fallback + section generators.\n184\tfunc NewPassthroughContentGenerator() ContentGenerator {\n185\t\treturn &passthroughContentGenerator{}\n186\t}\n187\t\n188\ttype passthroughContentGenerator struct{}\n189\t\n190\tfunc (g *passthroughContentGenerator) Generate(\n191\t\t_ context.Context,\n192\t\t_ string,\n193\t\tresult agentlib.AgentResultInfo,\n194\t) (string, error) {\n195\t\tupdated := applyStatusFrontmatter(result.Output, result)\n196\t\tif result.Status == agentlib.AgentStatusFailed ||\n197\t\t\tresult.Status == agentlib.AgentStatusNeedsInput {\n198\t\t\t// result.Output is unreliable on early-step failures — agents return\n199\t\t\t// status=failed/needs_input WITHOUT having written anything to Output.\n200\t\t\t// Surface result.Message via the shared ## Failure section so operators\n201\t\t\t// can diagnose without log archaeology. Mirrors fallback + section generators.\n202\t\t\treturn ReplaceOrAppendSection(updated, \"## Failure\", buildFailureSection(result)), nil\n203\t\t}\n204\t\treturn updated, nil\n205\t}\n206\t\n207\t// NewSectionContentGenerator creates a ContentGenerator that writes its output under a\n208\t// parameterized markdown heading (e.g. \"## Plan\", \"## Review\"). On agentlib.AgentStatusFailed\n209\t// it writes a \"## Failure\" section instead, regardless of the configured heading —\n210\t// the failure-section convention is repo-wide, not phase-specific.\n211\t//\n212\t// Use this for phase-aware agents whose phases write distinct sections (planning → ## Plan,\n213\t// execution → ## Result, review → ## Review).\n214\tfunc NewSectionContentGenerator(heading string) ContentGenerator {\n215\t\treturn &sectionContentGenerator{heading: heading}\n216\t}\n217\t\n218\ttype sectionContentGenerator struct {\n219\t\theading string\n220\t}\n221\t\n222\tfunc (g *sectionContentGenerator) Generate(\n223\t\t_ context.Context,\n224\t\toriginalContent string,\n225\t\tresult agentlib.AgentResultInfo,\n226\t) (string, error) {\n227\t\tupdated := applyStatusFrontmatter(originalContent, result)\n228\t\tif result.Status == agentlib.AgentStatusFailed {\n229\t\t\tsection := buildFailureSection(result)\n230\t\t\treturn ReplaceOrAppendSection(updated, \"## Failure\", section), nil\n231\t\t}\n232\t\tsection := result.Output\n233\t\tif section == \"\" {\n234\t\t\tsection = buildMinimalResultSection(result)\n235\t\t}\n236\t\treturn ReplaceOrAppendSection(updated, g.heading, section), nil\n237\t}\n238\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"443972aa-5e3c-40dc-987c-643d18c7c40f","timestamp":"2026-09-27T22:59:09.182Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-86dda177d5c95ae1","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage delivery\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"os\"\n10\t\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\tcdb \"github.com/bborbe/cqrs/cdb\"\n13\t\tcqrsiam \"github.com/bborbe/cqrs/iam\"\n14\t\t\"github.com/bborbe/errors\"\n15\t\tlibkafka \"github.com/bborbe/kafka\"\n16\t\t\"github.com/bborbe/log\"\n17\t\tlibtime \"github.com/bborbe/time\"\n18\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n19\t\t\"github.com/golang/glog\"\n20\t\t\"github.com/google/uuid\"\n21\t\n22\t\tagentlib \"github.com/bborbe/agent\"\n23\t)\n24\t\n25\t// metricsAgentTurnsKey and metricsInteractionCountKey are the frozen frontmatter keys\n26\t// this deliverer publishes for a Claude-backed run (spec 053). Lowercase, snake_case,\n27\t// no nesting, no version suffix, no alias.\n28\tconst (\n29\t\tmetricsAgentTurnsKey       = \"metrics_agent_turns\"\n30\t\tmetricsInteractionCountKey = \"metrics_interaction_count\"\n31\t)\n32\t\n33\t// NewNoopResultDeliverer creates a agentlib.ResultDeliverer that does nothing.\n34\tfunc NewNoopResultDeliverer() agentlib.ResultDeliverer {\n35\t\treturn &noopResultDeliverer{}\n36\t}\n37\t\n38\ttype noopResultDeliverer struct{}\n39\t\n40\tfunc (n *noopResultDeliverer) DeliverResult(_ context.Context, _ agentlib.AgentResultInfo) error {\n41\t\treturn nil\n42\t}\n43\t\n44\t// NewFileResultDeliverer creates a agentlib.ResultDeliverer that writes results to a task file.\n45\t// The generator produces the complete updated markdown; the deliverer writes it to disk.\n46\tfunc NewFileResultDeliverer(generator ContentGenerator, filePath string) agentlib.ResultDeliverer {\n47\t\treturn &fileResultDeliverer{generator: generator, filePath: filePath}\n48\t}\n49\t\n50\ttype fileResultDeliverer struct {\n51\t\tgenerator ContentGenerator\n52\t\tfilePath  string\n53\t}\n54\t\n55\tfunc (d *fileResultDeliverer) DeliverResult(\n56\t\tctx context.Context,\n57\t\tresult agentlib.AgentResultInfo,\n58\t) error {\n59\t\toriginal, err := os.ReadFile(\n60\t\t\td.filePath,\n61\t\t) // #nosec G304 -- filePath validated by caller\n62\t\tif err != nil {\n63\t\t\treturn errors.Wrap(ctx, err, \"read task file failed\")\n64\t\t}\n65\t\n66\t\tgenerated, err := d.generator.Generate(ctx, string(original), result)\n67\t\tif err != nil {\n68\t\t\treturn errors.Wrap(ctx, err, \"content generation failed\")\n69\t\t}\n70\t\n71\t\tif err := os.WriteFile(d.filePath, []byte(generated), 0600); err != nil { // #nosec G304 G703 -- filePath validated by caller\n72\t\t\treturn errors.Wrap(ctx, err, \"write task file failed\")\n73\t\t}\n74\t\treturn nil\n75\t}\n76\t\n77\t// NewKafkaResultDeliverer creates a agentlib.ResultDeliverer that publishes task updates to Kafka.\n78\t// taskID must be non-empty; if empty, use NewNoopResultDeliverer instead.\n79\t// originalContent is the original task markdown; the generator produces the complete updated content.\n80\t// topicPrefix selects the Kafka topic prefix (e.g. base.TopicPrefixFromBranch(branch) to\n81\t// preserve the legacy dev/prod topic names, or \"\" for unprefixed topics).\n82\tfunc NewKafkaResultDeliverer(\n83\t\tsyncProducer libkafka.SyncProducer,\n84\t\ttopicPrefix base.TopicPrefix,\n85\t\ttaskID agentlib.TaskIdentifier,\n86\t\toriginalContent string,\n87\t\tgenerator ContentGenerator,\n88\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n89\t) agentlib.ResultDeliverer {\n90\t\treturn NewKafkaResultDelivererWithSender(\n91\t\t\tcdb.NewCommandObjectSender(syncProducer, topicPrefix, log.DefaultSamplerFactory),\n92\t\t\ttaskID,\n93\t\t\toriginalContent,\n94\t\t\tgenerator,\n95\t\t\tcurrentDateTime,\n96\t\t)\n97\t}\n98\t\n99\t// NewKafkaResultDelivererWithSender creates a agentlib.ResultDeliverer that publishes task updates via the given sender.\n100\t// This constructor is primarily useful for testing.\n101\tfunc NewKafkaResultDelivererWithSender(\n102\t\tcommandObjectSender cdb.CommandObjectSender,\n103\t\ttaskID agentlib.TaskIdentifier,\n104\t\toriginalContent string,\n105\t\tgenerator ContentGenerator,\n106\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n107\t) agentlib.ResultDeliverer {\n108\t\treturn &kafkaResultDeliverer{\n109\t\t\tcommandObjectSender: commandObjectSender,\n110\t\t\ttaskID:              taskID,\n111\t\t\toriginalContent:     originalContent,\n112\t\t\tgenerator:           generator,\n113\t\t\tcurrentDateTime:     currentDateTime,\n114\t\t}\n115\t}\n116\t\n117\ttype kafkaResultDeliverer struct {\n118\t\tcommandObjectSender cdb.CommandObjectSender\n119\t\ttaskID              agentlib.TaskIdentifier\n120\t\toriginalContent     string\n121\t\tgenerator           ContentGenerator\n122\t\tcurrentDateTime     libtime.CurrentDateTimeGetter\n123\t}\n124\t\n125\tfunc (d *kafkaResultDeliverer) DeliverResult(\n126\t\tctx context.Context,\n127\t\tresult agentlib.AgentResultInfo,\n128\t) error {\n129\t\tgenerated, err := d.generator.Generate(ctx, d.originalContent, result)\n130\t\tif err != nil {\n131\t\t\treturn errors.Wrap(ctx, err, \"content generation failed\")\n132\t\t}\n133\t\n134\t\tfmMap, body := ParseMarkdownFrontmatter(generated)\n135\t\n136\t\tfrontmatter := agentlib.TaskFrontmatter{}\n137\t\tfor k, v := range fmMap {\n138\t\t\tfrontmatter[k] = v\n139\t\t}\n140\t\n141\t\td.applyResultMetrics(frontmatter, result)\n142\t\n143\t\td.applyResultFrontmatter(frontmatter, result)\n144\t\n145\t\td.stampTargetVault(frontmatter)\n146\t\n147\t\tnow := d.currentDateTime.Now()\n148\t\ttask := agentlib.Task{\n149\t\t\tObject: base.Object[base.Identifier]{\n150\t\t\t\tIdentifier: base.Identifier(uuid.New().String()),\n151\t\t\t\tCreated:    now,\n152\t\t\t\tModified:   now,\n153\t\t\t},\n154\t\t\tTaskIdentifier: d.taskID,\n155\t\t\tFrontmatter:    frontmatter,\n156\t\t\tContent:        agentlib.TaskContent(body),\n157\t\t}\n158\t\n159\t\tevent, err := base.ParseEvent(ctx, task)\n160\t\tif err != nil {\n161\t\t\treturn errors.Wrap(ctx, err, \"parse task event failed\")\n162\t\t}\n163\t\n164\t\trequestIDCh := make(chan base.RequestID, 1)\n165\t\trequestIDCh <- base.NewRequestID()\n166\t\tcommandCreator := base.NewCommandCreator(requestIDCh)\n167\t\tcommandObject := cdb.CommandObject{\n168\t\t\tCommand: commandCreator.NewCommand(\n169\t\t\t\tbase.UpdateOperation,\n170\t\t\t\tcqrsiam.Initiator(\"agent\"),\n171\t\t\t\t\"\",\n172\t\t\t\tevent,\n173\t\t\t),\n174\t\t\tSchemaID: agentlib.TaskV1SchemaID,\n175\t\t}\n176\t\n177\t\tglog.V(2).Infof(\"publishing task update for taskID=%s status=%s\", d.taskID, result.Status)\n178\t\tif err := d.commandObjectSender.SendCommandObject(ctx, commandObject); err != nil {\n179\t\t\treturn errors.Wrap(ctx, err, \"publish task update failed\")\n180\t\t}\n181\t\treturn nil\n182\t}\n183\t\n184\t// applyResultFrontmatter merges result.Status into the task frontmatter — status,\n185\t// assignee, and phase — per the retry-vs-escalate contract. Extracted into a helper\n186\t// so DeliverResult stays under the funlen limit.\n187\t//\n188\t// Retry-vs-escalate (spec 010/021): failed is an infra failure (transient — crash,\n189\t// timeout, OOM), so preserve assignee and keep the task routable; retry is the\n190\t// controller's responsibility via trigger_count / max_triggers, and it can only\n191\t// fire while assignee is set. Only at cap exhaustion does the task escalate:\n192\t// assignee cleared to \"\" (the operator-inbox signal), previous_assignee recorded\n193\t// (spec 027), phase left as the resume cursor.\n194\t//\n195\t// needs_input is task-wrong, not transient — the agent already did the work, so the\n196\t// task surfaces in the operator inbox immediately (assignee cleared, phase unchanged).\n197\t// Only the AgentStatusDone branch may write phase: human_review, and only when the\n198\t// agent itself requested it via Result.NextPhase.\n199\tfunc (d *kafkaResultDeliverer) applyResultFrontmatter(\n200\t\tfrontmatter agentlib.TaskFrontmatter,\n201\t\tresult agentlib.AgentResultInfo,\n202\t) {\n203\t\tswitch result.Status {\n204\t\tcase agentlib.AgentStatusDone:\n205\t\t\tif result.NextPhase == \"\" {\n206\t\t\t\t// Done without NextPhase is an in-place save (see agentlib.Result.NextPhase:\n207\t\t\t\t// \"Empty means stay in current phase\"): keep status: in_progress and preserve\n208\t\t\t\t// the phase from incoming frontmatter — exactly like the InProgress branch.\n209\t\t\t\t// Terminating a task requires an explicit NextPhase: \"done\".\n210\t\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n211\t\t\t\t// phase intentionally not modified — preserves incoming phase\n212\t\t\t\tbreak\n213\t\t\t}\n214\t\t\tresolvedPhase := resolveNextPhase(d.taskID, result.NextPhase)\n215\t\t\tfrontmatter[\"phase\"] = resolvedPhase\n216\t\t\t// Only mark the task completed when the resolved phase is terminal (done).\n217\t\t\t// Requested transitions to planning/execution/ai_review/human_review keep\n218\t\t\t// the task at status: in_progress so the controller re-triggers on the\n219\t\t\t// new phase. Without this, multi-phase agents stall after their first phase.\n220\t\t\tif resolvedPhase == \"done\" {\n221\t\t\t\tfrontmatter[\"status\"] = \"completed\"\n222\t\t\t} else {\n223\t\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n224\t\t\t}\n225\t\tcase agentlib.AgentStatusNeedsInput:\n226\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n227\t\t\t// Task-wrong (permanent): the agent already did the work, so the task surfaces\n228\t\t\t// in the operator inbox immediately. Record the pre-clear owner (spec 027).\n229\t\t\tif prev := string(frontmatter.Assignee()); prev != \"\" {\n230\t\t\t\tfrontmatter[\"previous_assignee\"] = prev\n231\t\t\t}\n232\t\t\tfrontmatter[\"assignee\"] = \"\"\n233\t\t\t// phase is preserved from incoming frontmatter (already copied from fmMap above)\n234\t\tcase agentlib.AgentStatusInProgress:\n235\t\t\t// Step-level progress save: keep status: in_progress, preserve phase from incoming\n236\t\t\t// task frontmatter. NextPhase ignored on this status — log a warning if set both.\n237\t\t\tif result.NextPhase != \"\" {\n238\t\t\t\tglog.Warningf(\"task %s: ignoring NextPhase %q on Status: in_progress (in-place save)\",\n239\t\t\t\t\td.taskID, result.NextPhase)\n240\t\t\t}\n241\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n242\t\t\t// phase intentionally not modified — preserves incoming phase\n243\t\tcase agentlib.AgentStatusFailed:\n244\t\t\t// Infra failure (transient): preserve assignee so the trigger_count / max_triggers\n245\t\t\t// retry path stays reachable — clearing it here would make the task unroutable and\n246\t\t\t// the retry silently never happen. Only at cap exhaustion does the task escalate\n247\t\t\t// to the operator inbox.\n248\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n249\t\t\tif frontmatter.TriggerCount() >= frontmatter.MaxTriggers() {\n250\t\t\t\tif prev := string(frontmatter.Assignee()); prev != \"\" {\n251\t\t\t\t\tfrontmatter[\"previous_assignee\"] = prev\n252\t\t\t\t}\n253\t\t\t\tfrontmatter[\"assignee\"] = \"\"\n254\t\t\t}\n255\t\t\t// phase is preserved from incoming frontmatter (already copied from fmMap above)\n256\t\tdefault:\n257\t\t\t// Unknown status: defensive — surface to the operator like a cap exhaustion.\n258\t\t\tfrontmatter[\"status\"] = \"in_progress\"\n259\t\t\tif prev := string(frontmatter.Assignee()); prev != \"\" {\n260\t\t\t\tfrontmatter[\"previous_assignee\"] = prev\n261\t\t\t}\n262\t\t\tfrontmatter[\"assignee\"] = \"\"\n263\t\t\t// phase is preserved from incoming frontmatter (already copied from fmMap above)\n264\t\t}\n265\t}\n266\t\n267\t// applyResultMetrics writes the run's observed counts into the published frontmatter.\n268\t// It runs BEFORE applyResultFrontmatter so the entries ride every status path the\n269\t// deliverer publishes.\n270\t//\n271\t// Both values are optional: a nil field means the run produced no measurement (the\n272\t// turn summary reported nothing positive, or the transcript evidence was\n273\t// unavailable) and its key is omitted entirely — absence is never substituted with a\n274\t// zero. Values are written as plain integers; nothing else about the payload changes.\n275\t//\n276\t// A count already recorded on the task the run received is never lowered: when the\n277\t// recorded value is higher than the run's own evidence, the run's value is discarded\n278\t// and the recorded one stands. This is a guard on this deliverer's own output, not a\n279\t// merge — no read-modify-write of any task file, no second writer.\n280\tfunc (d *kafkaResultDeliverer) applyResultMetrics(\n281\t\tfrontmatter agentlib.TaskFrontmatter,\n282\t\tresult agentlib.AgentResultInfo,\n283\t) {\n284\t\tif result.AgentTurns != nil {\n285\t\t\tfrontmatter[metricsAgentTurnsKey] = *result.AgentTurns\n286\t\t}\n287\t\tif result.InteractionCount == nil {\n288\t\t\treturn\n289\t\t}\n290\t\tif recorded, ok := recordedInteractionCount(d.originalContent); ok &&\n291\t\t\t*result.InteractionCount < recorded {\n292\t\t\tglog.V(2).Infof(\n293\t\t\t\t\"task %s: keeping recorded %s=%d, run observed %d\",\n294\t\t\t\td.taskID,\n295\t\t\t\tmetricsInteractionCountKey,\n296\t\t\t\trecorded,\n297\t\t\t\t*result.InteractionCount,\n298\t\t\t)\n299\t\t\treturn\n300\t\t}\n301\t\tfrontmatter[metricsInteractionCountKey] = *result.InteractionCount\n302\t}\n303\t\n304\t// recordedInteractionCount reads the interaction count already recorded on the task\n305\t// content the run received. ok is false when the key is absent, unparseable, or does\n306\t// not hold a non-negative integer.\n307\tfunc recordedInteractionCount(originalContent string) (int64, bool) {\n308\t\tfm, _ := ParseMarkdownFrontmatter(originalContent)\n309\t\tfrontmatter := agentlib.TaskFrontmatter{}\n310\t\tfor k, v := range fm {\n311\t\t\tfrontmatter[k] = v\n312\t\t}\n313\t\trecorded, ok := frontmatter.Int(metricsInteractionCountKey)\n314\t\tif !ok || recorded < 0 {\n315\t\t\treturn 0, false\n316\t\t}\n317\t\treturn int64(recorded), true\n318\t}\n319\t\n320\t// stampTargetVault adds target_vault to the task frontmatter from the original\n321\t// task content when the generated content lacks it. Stub results (failed /\n322\t// needs_input / unsupported-phase, empty or body-only Output) produce\n323\t// status-only generated frontmatter; without target_vault the controller's\n324\t// routing guard (routing.ShouldProcessResult) falls through to legacy routing\n325\t// and the non-owning controller scans-and-drops the result (spec 052). No-op\n326\t// when the generated content already carries target_vault (full results echo\n327\t// unchanged), or when originalContent has no frontmatter / no target_vault\n328\t// (legacy tasks and direct CLI runs keep today's routing).\n329\tfunc (d *kafkaResultDeliverer) stampTargetVault(frontmatter agentlib.TaskFrontmatter) {\n330\t\tif _, ok := frontmatter[\"target_vault\"]; ok {\n331\t\t\treturn\n332\t\t}\n333\t\toriginalFM, _ := ParseMarkdownFrontmatter(d.originalContent)\n334\t\tif tv, ok := originalFM[\"target_vault\"].(string); ok && tv != \"\" {\n335\t\t\tfrontmatter[\"target_vault\"] = tv\n336\t\t}\n337\t}\n338\t\n339\t// resolveNextPhase returns the validated phase string for a done agent result\n340\t// with a non-empty requested NextPhase (empty NextPhase is an in-place save and\n341\t// never reaches this function). An invalid value is logged with task-id context\n342\t// and falls back to \"done\" — we never refuse to write a result just because the\n343\t// agent requested a bogus phase.\n344\tfunc resolveNextPhase(\n345\t\ttaskID agentlib.TaskIdentifier,\n346\t\trequested string,\n347\t) string {\n348\t\tcanonical, ok := domain.NormalizeTaskPhase(requested)\n349\t\tif !ok {\n350\t\t\tglog.Warningf(\"task %s: ignoring invalid NextPhase %q: unknown phase\", taskID, requested)\n351\t\t\treturn \"done\"\n352\t\t}\n353\t\treturn string(canonical)\n354\t}\n355\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"e8446433-fa4e-4230-a994-912012d6ae35","timestamp":"2026-09-27T22:59:09.183Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
