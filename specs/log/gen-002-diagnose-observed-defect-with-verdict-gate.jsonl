{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a5fbe6e958c3c7ae","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage claude\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"strings\"\n10\t)\n11\t\n12\t// Instructions is a list of named prompt sections.\n13\ttype Instructions []Instruction\n14\t\n15\t// Strings returns each instruction rendered as an XML-tagged string.\n16\tfunc (ii Instructions) Strings() []string {\n17\t\tresult := make([]string, len(ii))\n18\t\tfor i, inst := range ii {\n19\t\t\tresult[i] = inst.String()\n20\t\t}\n21\t\treturn result\n22\t}\n23\t\n24\t// String renders all instructions separated by newlines.\n25\tfunc (ii Instructions) String() string {\n26\t\treturn strings.Join(ii.Strings(), \"\\n\")\n27\t}\n28\t\n29\t// Instruction is a named prompt section wrapped in XML tags.\n30\ttype Instruction struct {\n31\t\tName    string\n32\t\tContent string\n33\t}\n34\t\n35\t// String renders the instruction as an XML-tagged block.\n36\tfunc (i Instruction) String() string {\n37\t\treturn fmt.Sprintf(\"<%s>%s</%s>\", i.Name, i.Content, i.Name)\n38\t}\n39\t"}]},"parent_tool_use_id":"chatcmpl-tool-878ead37275ea3cd","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"3ec04b38-f462-4743-8852-d4d06304de1b","timestamp":"2026-09-27T22:59:38.312Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts for spec 002"}
