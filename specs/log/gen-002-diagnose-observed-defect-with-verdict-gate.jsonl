{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9af2d6f452eb8e2f","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage factory_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tagentlib \"github.com/bborbe/agent\"\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\tkafkamocks \"github.com/bborbe/kafka/mocks\"\n13\t\tlibtime \"github.com/bborbe/time\"\n14\t\t. \"github.com/onsi/ginkgo/v2\"\n15\t\t. \"github.com/onsi/gomega\"\n16\t\n17\t\t\"github.com/bborbe/defect-diagnoser-agent/pkg/factory\"\n18\t)\n19\t\n20\t// This is a golden-master characterization test. It pins the exact Kafka\n21\t// topic name produced by CreateKafkaResultDeliverer for a given TopicPrefix,\n22\t// proving the migration from base.Branch to base.TopicPrefix preserves the\n23\t// existing dev/prod topic names and adds a clean unprefixed case.\n24\tvar _ = Describe(\"CreateKafkaResultDeliverer topic naming (golden master)\", func() {\n25\t\tvar (\n26\t\t\tctx             context.Context\n27\t\t\tfakeProducer    *kafkamocks.KafkaSyncProducer\n28\t\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n29\t\t)\n30\t\n31\t\tBeforeEach(func() {\n32\t\t\tctx = context.Background()\n33\t\t\tfakeProducer = &kafkamocks.KafkaSyncProducer{}\n34\t\t\tfakeProducer.SendMessageReturns(0, 0, nil)\n35\t\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n36\t\t})\n37\t\n38\t\tdeliver := func(topicPrefix base.TopicPrefix) string {\n39\t\t\tdeliverer := factory.CreateKafkaResultDeliverer(\n40\t\t\t\tfakeProducer,\n41\t\t\t\ttopicPrefix,\n42\t\t\t\tagentlib.TaskIdentifier(\"task-1\"),\n43\t\t\t\t\"# Task\\n\\nbody\",\n44\t\t\t\tcurrentDateTime,\n45\t\t\t)\n46\t\t\tExpect(deliverer.DeliverResult(ctx, agentlib.AgentResultInfo{\n47\t\t\t\tStatus: agentlib.AgentStatusDone,\n48\t\t\t\tOutput: \"# Task\\n\\nbody\",\n49\t\t\t})).To(Succeed())\n50\t\t\tExpect(fakeProducer.SendMessageCallCount()).To(Equal(1))\n51\t\t\t_, msg := fakeProducer.SendMessageArgsForCall(0)\n52\t\t\treturn msg.Topic\n53\t\t}\n54\t\n55\t\tIt(\"prefixes with 'develop-' for TopicPrefix(\\\"develop\\\")\", func() {\n56\t\t\tExpect(deliver(base.TopicPrefix(\"develop\"))).To(Equal(\"develop-agent-task-v1-request\"))\n57\t\t})\n58\t\n59\t\tIt(\"prefixes with 'master-' for TopicPrefix(\\\"master\\\")\", func() {\n60\t\t\tExpect(deliver(base.TopicPrefix(\"master\"))).To(Equal(\"master-agent-task-v1-request\"))\n61\t\t})\n62\t\n63\t\tIt(\"is unprefixed for an empty TopicPrefix\", func() {\n64\t\t\tExpect(deliver(base.TopicPrefix(\"\"))).To(Equal(\"agent-task-v1-request\"))\n65\t\t})\n66\t})\n67\t"}]},"parent_tool_use_id":"chatcmpl-tool-9cbee98593beadc5","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"214edb56-92b4-4930-ae49-31eccd9d1df9","timestamp":"2026-09-27T23:33:44.305Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 3"}
