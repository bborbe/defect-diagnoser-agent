{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9835929280741f85","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package factory wires concrete dependencies for the defect-diagnoser-agent binary.\n6\t//\n7\t// All factory functions follow the Create* prefix convention and contain\n8\t// zero business logic — they compose constructors with config.\n9\tpackage factory\n10\t\n11\timport (\n12\t\t\"context\"\n13\t\n14\t\tagentlib \"github.com/bborbe/agent\"\n15\t\tclaudelib \"github.com/bborbe/agent/claude\"\n16\t\tdelivery \"github.com/bborbe/agent/delivery\"\n17\t\thealthcheck \"github.com/bborbe/agent/healthcheck\"\n18\t\t\"github.com/bborbe/cqrs/base\"\n19\t\tlibkafka \"github.com/bborbe/kafka\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n22\t\n23\t\t\"github.com/bborbe/defect-diagnoser-agent/pkg/prompts\"\n24\t)\n25\t\n26\tconst serviceName = \"defect-diagnoser-agent\"\n27\t\n28\t// CreateClaudeRunner constructs a ClaudeRunner pre-configured with tools,\n29\t// model, working directory, and CLI environment.\n30\tfunc CreateClaudeRunner(\n31\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n32\t\tagentDir claudelib.AgentDir,\n33\t\tallowedTools claudelib.AllowedTools,\n34\t\tmodel claudelib.ClaudeModel,\n35\t\tenv map[string]string,\n36\t) claudelib.ClaudeRunner {\n37\t\treturn claudelib.NewClaudeRunner(claudelib.ClaudeRunnerConfig{\n38\t\t\tClaudeConfigDir:  claudeConfigDir,\n39\t\t\tAllowedTools:     allowedTools,\n40\t\t\tModel:            model,\n41\t\t\tWorkingDirectory: agentDir,\n42\t\t\tEnv:              env,\n43\t\t})\n44\t}\n45\t\n46\t// CreateSyncProducer creates a Kafka sync producer.\n47\tfunc CreateSyncProducer(\n48\t\tctx context.Context,\n49\t\tbrokers libkafka.Brokers,\n50\t) (libkafka.SyncProducer, error) {\n51\t\treturn libkafka.NewSyncProducerWithName(ctx, brokers, serviceName)\n52\t}\n53\t\n54\t// CreateKafkaResultDeliverer creates a ResultDeliverer that publishes task\n55\t// updates to Kafka via CQRS commands. Uses the passthrough content generator\n56\t// — the agent framework's StepRunner already produces the full marshaled\n57\t// task in result.Output; the deliverer publishes it as-is and overrides\n58\t// status/phase frontmatter based on the result Status.\n59\tfunc CreateKafkaResultDeliverer(\n60\t\tsyncProducer libkafka.SyncProducer,\n61\t\ttopicPrefix base.TopicPrefix,\n62\t\ttaskID agentlib.TaskIdentifier,\n63\t\toriginalContent string,\n64\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n65\t) agentlib.ResultDeliverer {\n66\t\treturn delivery.NewKafkaResultDeliverer(\n67\t\t\tsyncProducer,\n68\t\t\ttopicPrefix,\n69\t\t\ttaskID,\n70\t\t\toriginalContent,\n71\t\t\tdelivery.NewPassthroughContentGenerator(),\n72\t\t\tcurrentDateTime,\n73\t\t)\n74\t}\n75\t\n76\t// CreateFileResultDeliverer creates a ResultDeliverer that writes the agent's\n77\t// output back to a markdown file (local CLI mode). Uses the passthrough\n78\t// content generator (same rationale as Kafka).\n79\tfunc CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer {\n80\t\treturn delivery.NewFileResultDeliverer(\n81\t\t\tdelivery.NewPassthroughContentGenerator(),\n82\t\t\tfilePath,\n83\t\t)\n84\t}\n85\t\n86\t// CreateAgent assembles the full 3-phase claude agent. Single Claude step\n87\t// shared across planning / in_progress / ai_review preserves the existing\n88\t// CRD trigger.phases behavior — every phase runs Claude once and emits\n89\t// done.\n90\tfunc CreateAgent(\n91\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n92\t\tagentDir claudelib.AgentDir,\n93\t\tallowedTools claudelib.AllowedTools,\n94\t\tmodel claudelib.ClaudeModel,\n95\t\tclaudeEnv map[string]string,\n96\t\tenvContext map[string]string,\n97\t) *agentlib.Agent {\n98\t\treturn CreateAgentFromRunner(\n99\t\t\tCreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv),\n100\t\t\tenvContext,\n101\t\t)\n102\t}\n103\t\n104\t// CreateAgentFromRunner builds the 3-phase claude agent given a pre-constructed\n105\t// ClaudeRunner. Used by CreateAgentProvider to share one runner across the\n106\t// domain agent and the healthcheck-Claude liveness agent.\n107\tfunc CreateAgentFromRunner(\n108\t\trunner claudelib.ClaudeRunner,\n109\t\tenvContext map[string]string,\n110\t) *agentlib.Agent {\n111\t\tstep := claudelib.NewAgentStep(claudelib.AgentStepConfig{\n112\t\t\tName:          \"claude-task\",\n113\t\t\tRunner:        runner,\n114\t\t\tInstructions:  prompts.BuildInstructions(),\n115\t\t\tEnvContext:    envContext,\n116\t\t\tOutputSection: \"## Result\",\n117\t\t\tNextPhase:     \"done\",\n118\t\t})\n119\t\treturn agentlib.NewAgent(\n120\t\t\tagentlib.NewPhase(\"planning\", step),\n121\t\t\tagentlib.NewPhase(domain.TaskPhaseExecution, step),\n122\t\t\tagentlib.NewPhase(\"ai_review\", step),\n123\t\t)\n124\t}\n125\t\n126\t// CreateAgentProvider wires the per-task-type dispatch table for defect-diagnoser-agent.\n127\t// Returns lib.AgentProvider — main.go calls Get(ctx, taskType) to select the\n128\t// appropriate *Agent. Pure plumbing; no conditional, no error.\n129\t//\n130\t// TaskTypeLLM routes to the existing 3-phase domain agent. TaskTypeHealthcheck\n131\t// and TaskTypeOAuthProbe (transition alias) both route to the shared\n132\t// healthcheck-Claude liveness agent, reusing the same ClaudeRunner.\n133\tfunc CreateAgentProvider(\n134\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n135\t\tagentDir claudelib.AgentDir,\n136\t\tallowedTools claudelib.AllowedTools,\n137\t\tmodel claudelib.ClaudeModel,\n138\t\tclaudeEnv map[string]string,\n139\t\tenvContext map[string]string,\n140\t) agentlib.AgentProvider {\n141\t\trunner := CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv)\n142\t\tdomainAgent := CreateAgentFromRunner(runner, envContext)\n143\t\tlivenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(runner))\n144\t\treturn agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n145\t\t\tagentlib.TaskTypeLLM:         domainAgent,\n146\t\t\tagentlib.TaskTypeHealthcheck: livenessAgent,\n147\t\t\tagentlib.TaskTypeOAuthProbe:  livenessAgent,\n148\t\t})\n149\t}\n150\t"}]},"parent_tool_use_id":"chatcmpl-tool-8184a1f4e4436900","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"30fc580c-7747-437b-acb4-cd6fd2757b1c","timestamp":"2026-09-27T23:31:28.432Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bb508debf1fc3c47","type":"tool_result","content":"1\t---\n2\tstatus: executing\n3\tspec: [001-read-only-observation-toolkit]\n4\texecution_id: defect-diagnoser-agent-diagnose-v1-exec-003-spec-001-config-allowlist-and-consistency\n5\tdark-factory-version: dev\n6\tcreated: \"2026-09-27T22:45:00Z\"\n7\tqueued: \"2026-09-27T23:02:59Z\"\n8\tstarted: \"2026-09-27T23:24:41Z\"\n9\tbranch: dark-factory/read-only-observation-toolkit\n10\t---\n11\t\n12\t# Align the Config allowlist, image and prose, and enforce the agreement with a test\n13\t\n14\t<summary>\n15\t\n16\t- The Config's tool allowlist stops naming a script that cannot work and matches the four scripts that exist.\n17\t- The vault and Prometheus addresses now reach the model through the channel the runner actually forwards, instead of sitting in pod env where they were silently dropped.\n18\t- The dead plain-environment keys for those two addresses are gone.\n19\t- The Config's comments describe the deferred Kubernetes read path in the same words the README uses.\n20\t- The container image ships `git`, so the clone script can run at all.\n21\t- A local clone directory cannot be committed by accident.\n22\t- The guardrails and the README describe the two read paths that actually exist, and the README no longer advises a code change for something the Config already handles.\n23\t- A test fails the build if the allowlist, the scripts on disk and the prose ever disagree in any direction.\n24\t- The changelog records the change.\n25\t\n26\t</summary>\n27\t\n28\t<objective>\n29\t\n30\tClose the gap between what the Config claims and what the image actually contains. Today the Config allowlists five scripts, none of which exists, one of which (`pod-logs.sh`) cannot work on the current platform; it also sets the two endpoint URLs as plain pod env, which the Claude runner strips before spawning the model — so even a correct script would fail with \"variable is required\" while `kubectl describe pod` shows the variable set. After this change the allowlist, the scripts on disk and the prompt/guardrail prose agree in every direction, and a test enforces that agreement so the next drift fails `make test` instead of failing at runtime.\n31\t\n32\t</objective>\n33\t\n34\t<context>\n35\t\n36\tRead these before writing anything:\n37\t\n38\t- `docs/observation-scripts.md` — the **authoritative contract** for the scripts. Read the \"How the scripts get their env\" section in full; it names the exact Config value this prompt commits.\n39\t- `k8s/defect-diagnoser-agent-config.yaml` — the Config being edited.\n40\t- `agent/.claude/CLAUDE.md` — the guardrails prose being edited.\n41\t- `README.md` — the Env Vars table and the \"Claude subprocess env allowlist\" section.\n42\t- `CHANGELOG.md` — the file to append an `## Unreleased` section to.\n43\t- `Dockerfile` — the `apk --no-cache add` line that must gain `git`. Note the final stage is `FROM alpine`, which resolves to the earlier stage **named** `alpine`, so packages installed in that stage do ship in the image.\n44\t- `.gitignore` — the file to extend.\n45\t- `main.go` and `cmd/run-task/main.go` — read them to confirm the claim that no Go change is needed: both already parse `CLAUDE_ENV` (`env:\"CLAUDE_ENV\"`, arg `-claude-env`) through `envparse.KeyValuePairs` into the runner's env map. **Do not edit either file.**\n46\t- `pkg/prompts/workflow.md`, `pkg/prompts/output-format.md` — the embedded prompts the consistency test scans for script mentions.\n47\t- `pkg/factory/factory_suite_test.go` and `pkg/factory/factory_test.go` — the repo's Ginkgo/Gomega test idiom.\n48\t- `/home/node/.claude/CLAUDE.md` — the container's execution rules.\n49\t- `/home/node/.claude/plugins/marketplaces/coding/docs/changelog-guide.md` — entry format and the required `feat:`/`fix:`/… prefix.\n50\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-testing-guide.md` — Ginkgo/Gomega conventions.\n51\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-precommit.md` — linter limits that apply to test files too (`funlen` 80 lines / 50 statements, `gocognit` 20, `nestif` 4, golines max-len 100).\n52\t- `docs/dod.md` — the Definition of Done for this repo (it explicitly requires the CHANGELOG entry and the docs update).\n53\t\n54\tThis prompt depends on prompts 1 and 2 of spec 001 (`1-spec-001-http-observation-scripts`, `2-spec-001-repo-clone-script`). Precondition: `agent/scripts/vault-read.sh`, `agent/scripts/vault-list.sh`, `agent/scripts/prometheus-query.sh`, `agent/scripts/repo-clone.sh` and `pkg/scripts/scripts_suite_test.go` all exist. If any is missing, stop and report `failed` naming the missing file — do not create it. `pkg/scripts/scripts_suite_test.go` already exists from a sibling prompt in this spec and defines `repoRoot()`. **Leave it untouched**, do not create a second suite file (two `RunSpecs` calls in one package fail the build), and do not redefine `repoRoot()`.\n55\t\n56\t<!-- Two deliberate deviations from the spec's literal AC text, both preserving the AC's intent:\n57\t\n58\t     1. AC7/AC11 write the leading whitespace as `\\s`. `[[:space:]]` is used here instead:\n59\t        portable across grep builds and asserts the identical thing.\n60\t\n61\t     2. AC8's exact-string check is written in the spec as `grep -c '<allowlist>'`. Plain\n62\t        `grep` is BRE, where `*` is a quantifier — the pattern `Bash(scripts/vault-read.sh:*)`\n63\t        compiles to \"…vault-read.sh\" + zero-or-more `:` + \")\", which does NOT match the file\n64\t        and returns 0, so the AC's stated `1` is unreachable with that exact command.\n65\t        `grep -cF` (fixed string) returns the intended 1 and is verified to do so. -->\n66\t\n67\t</context>\n68\t\n69\t<requirements>\n70\t\n71\t1. **`k8s/defect-diagnoser-agent-config.yaml`** — three edits, nothing else in the file changes. The `NOT APPLIED` header, the `metadata`/`spec` values, `taskTypes`, `resources`, `secretName` and the `ANTHROPIC_*` keys all stay as they are.\n72\t\n73\t   a. Replace the `ALLOWED_TOOLS` value. Old → new:\n74\t\n75\t   ```yaml\n76\t   # old\n77\t   ALLOWED_TOOLS: \"Read,Grep,Glob,Bash(scripts/vault-read.sh:*),Bash(scripts/vault-list.sh:*),Bash(scripts/prometheus-query.sh:*),Bash(scripts/pod-logs.sh:*),Bash(scripts/repo-clone.sh:*)\"\n78\t   # new — the `pod-logs.sh` entry is dropped; the four surviving names are unchanged\n79\t   ALLOWED_TOOLS: \"Read,Grep,Glob,Bash(scripts/vault-read.sh:*),Bash(scripts/vault-list.sh:*),Bash(scripts/prometheus-query.sh:*),Bash(scripts/repo-clone.sh:*)\"\n80\t   ```\n81\t\n82\t   b. Delete the plain `GIT_REST_URL:` and `PROMETHEUS_URL:` keys from `spec.env` and add `CLAUDE_ENV` in their place. The `CLAUDE_ENV` line must be indented, end immediately after the closing quote (no trailing comment on that line), and hold exactly:\n83\t\n84\t   ```yaml\n85\t   CLAUDE_ENV: \"GIT_REST_URL=http://vault-obsidian-personal:9090,PROMETHEUS_URL=http://prometheus.monitoring:9090\"\n86\t   ```\n87\t\n88\t   Replace the surrounding comments so they explain the mechanism rather than the old state — the current comment still says the scripts are \"not yet written — domain work\", which is no longer true, and the current endpoint comments sit on the two keys being deleted. Say that the Claude runner strips pod env down to a fixed allowlist, so the endpoint URLs reach the scripts only through `CLAUDE_ENV`, a comma-separated `KEY=VALUE` list parsed by both entry points.\n89\t\n90\t   c. Rewrite the trailing comment block about read path 3. It must contain the exact phrase `Kubernetes API reads, deferred — see NEXT-DIRECTIONS v2`, must keep the substance about the missing `serviceAccount` field and the gated RBAC, and must not contain any case-insensitive match of `pod[- ]?logs` (e.g. `Pod logs`, `pod-logs`) (the platform cannot read pod logs, which is why the script is being dropped). Keep `pods/log` out of the phrase \"Pod logs\" — describing the ServiceAccount's future permissions is fine.\n91\t\n92\t2. **`Dockerfile`** — add `git` to the existing `apk --no-cache add` line, keeping the rest of the package list and the trailing backslash intact. No other Dockerfile change.\n93\t\n94\t3. **`.gitignore`** — ensure it contains exactly one line `/agent/repos/` (leading slash, so it anchors to the repo root and does not shadow anything else). A sibling prompt may already have added it because its tests create the directory: if the line is present, leave it alone; if it is absent, add it; never duplicate it. Leave the other entries as they are.\n95\t\n96\t4. **`agent/.claude/CLAUDE.md`** — one edit: the domain bullet that reads \"(task files, Prometheus, pod logs/events)\" becomes \"(task files, Prometheus)\". Nothing else in the file changes; the `## Forbidden` section stays exactly as it is, and the scripts remain the sole exception to the internal-network rule.\n97\t\n98\t5. **`README.md`** — three edits.\n99\t\n100\t   a. The \"Observes\" bullet (currently \"task files → Prometheus → pod logs/events via its own read-only service account\") becomes:\n101\t\n102\t   ```markdown\n103\t   - **Observes (read-only, in order):** task files → Prometheus (Kubernetes API reads, deferred — see NEXT-DIRECTIONS v2)\n104\t   ```\n105\t\n106\t   The phrase `task files → Prometheus` must survive verbatim, and the deferred wording must be the same phrase used in the Config.\n107\t\n108\t   b. Rewrite the `### Claude subprocess env allowlist` section. Keep the heading verbatim. Keep the warning that the runner strips pod env down to a safe allowlist (`HOME,PATH,USER,TZ,...`) so a variable visible in `kubectl describe pod` can still be absent from the subprocess. Replace the advice to thread variables through `ClaudeRunnerConfig.Env` in `main.go`, and drop the \"See `docs/` for precedent (trade-analysis commit …)\" sentence — the string `ClaudeRunnerConfig.Env` must not appear anywhere in the file afterwards. Name `CLAUDE_ENV` as the channel: a comma-separated `KEY=VALUE` list set on the Config's `spec.env` (or `-claude-env` for a local run) and parsed by both entry points. Include one line that contains `CLAUDE_ENV` and both endpoints, for example:\n109\t\n110\t   ```markdown\n111\t   `CLAUDE_ENV: \"GIT_REST_URL=http://vault-obsidian-personal:9090,PROMETHEUS_URL=http://prometheus.monitoring:9090\"`\n112\t   ```\n113\t\n114\t   c. Link `docs/observation-scripts.md` from the README — at minimum from the rewritten section, and add it to the `## Related` list.\n115\t\n116\t   d. In `### Config CRD env pattern`, the yaml block is labelled \"Example from `k8s/defect-diagnoser-agent-config.yaml`\" but does not match that file: replace its `ALLOWED_TOOLS` line with the Config's real value, or relabel it as a generic example.\n117\t\n118\t   Leave the generic `Tune ALLOWED_TOOLS per task shape` example table alone: it illustrates other agents' tool sets (`vault-write.sh`, `trading-api-read.sh`) and is not a claim about this agent.\n119\t\n120\t6. **`CHANGELOG.md`** — add an `## Unreleased` section above `## v0.0.0` with one bullet describing what was implemented. Follow `changelog-guide.md`: the entry needs a `feat:` prefix and must mention \"observation scripts\". Do not describe verification steps, and do not use the prompt filename.\n121\t\n122\t7. **`pkg/scripts/consistency_test.go`** (`package scripts_test`, using the existing suite file and `repoRoot()`) — the three-way agreement test. It must parse the Config rather than hard-coding a copy of the allowlist:\n123\t\n124\t   a. Read `k8s/defect-diagnoser-agent-config.yaml` and extract the `ALLOWED_TOOLS` value with a regex equivalent to `(?m)^\\s*ALLOWED_TOOLS:\\s*\"(.*)\"\\s*$`. Fail loudly if it does not match — a silently empty allowlist would make every check below vacuous.\n125\t\n126\t   b. Split the value on `,` and collect the entries matching `^Bash\\(scripts/(.+):\\*\\)$`, keeping the captured script name. Compare the captured names as plain strings — never by re-grepping the file, because a shell `grep` pattern containing `:*` is a BRE quantifier and would silently match nothing.\n127\t\n128\t   c. Assert that set equals exactly `{vault-read.sh, vault-list.sh, prometheus-query.sh, repo-clone.sh}`, so an emptied or renamed allowlist cannot pass vacuously.\n129\t\n130\t   d. For every allowlisted script name, assert `agent/scripts/<name>` exists and is executable.\n131\t\n132\t   e. Walk `agent/scripts/`; for every regular file with any executable bit set, assert an allowlist entry names it. This is the direction that catches a new script nobody allowlisted.\n133\t\n134\t   f. Read `pkg/prompts/*.md` and `agent/.claude/CLAUDE.md`; find every `scripts/<name>.sh` mention with a regex equivalent to `scripts/([A-Za-z0-9._-]+\\.sh)`; assert each mentioned name has an allowlist entry. This is the direction that catches prose pointing at a tool that does not exist.\n135\t\n136\t   g. Assert no case-insensitive match of `pod[- ]?logs` in any of: `k8s/defect-diagnoser-agent-config.yaml`, `agent/.claude/CLAUDE.md`, `README.md`, and every `pkg/prompts/*.md`. This is the negative half of the agreement: the dropped tool must not linger in prose or comments.\n137\t\n138\t   h. Assert the Config's `CLAUDE_ENV` value — extracted with a regex equivalent to `(?m)^\\s*CLAUDE_ENV:\\s*\"(.*)\"\\s*$` — parses into both keys. Mirror the call in `main.go` (`claudeEnv := envparse.KeyValuePairs(a.ClaudeEnvRaw)`): read that line first to confirm the import path, the call form and the result type, then use the same call here and assert the map contains `GIT_REST_URL` and `PROMETHEUS_URL` with the values `http://vault-obsidian-personal:9090` and `http://prometheus.monitoring:9090`. This is the container-side guard for the seam that the operator-side acceptance check proves on the host: a Config value that greps correctly but parses into one key would otherwise ship. Before applying this regex and the ALLOWED_TOOLS regex, extract the `spec.env` block (the lines after `^  env:$` whose indent is at least 4, up to the next line with indent 2 or less) and match only inside it, so a `CLAUDE_ENV` placed at `spec` level or elsewhere fails. Do not add a YAML library (no `go get`).\n139\t\n140\t   Note that `README.md` is deliberately **not** part of check (f): its example allowlist table names scripts belonging to other agents.\n141\t\n142\t8. Keep every `It` body under ~60 lines; factor shared reading/parsing into helpers so `funlen` (80 lines / 50 statements) and `gocognit` (20) pass.\n143\t\n144\t9. Before finishing, re-run `<verification>` and confirm every line passes. Walk requirements 1–7 against the files you changed and confirm each exact string is present (or absent, where the requirement is a removal).\n145\t\n146\t</requirements>\n147\t\n148\t<constraints>\n149\t\n150\t- **Frozen tool names.** The four `Bash(scripts/…)` allowlist entries keep their exact names, resolved relative to the agent working directory. The Dockerfile's existing `COPY agent/ /agent/` ships them.\n151\t- **Script contracts are frozen in `docs/observation-scripts.md`.** A behaviour change updates that page in the same change. Do not change that page in this prompt.\n152\t- **No Go change for env.** `CLAUDE_ENV` / `ClaudeEnvRaw` in `main.go` and `cmd/run-task/main.go` stays exactly as it is. No new flag, field or helper for the two URLs.\n153\t- `k8s/defect-diagnoser-agent-config.yaml` keeps its `NOT APPLIED` header. Only `ALLOWED_TOOLS`, the env keys and the path-3 comments change.\n154\t- `agent/.claude/CLAUDE.md` § Forbidden is unchanged. The scripts remain the sole exception to the internal-network rule.\n155\t- Do NOT add a `pod-logs.sh`, a pod-log/event read, or any replacement for it. It waits on the Config CRD gaining a service-account field and is an explicit non-goal.\n156\t- No `kubectl apply`, deploy, secret manifest or RBAC. The Config file stays NOT APPLIED.\n157\t- Do NOT change the `github.com/bborbe/agent` module. No `go get`, never `-mod=vendor`.\n158\t- Do NOT create or modify the scripts under `agent/scripts/` — they are sibling prompts' deliverables, and this prompt only reads them. Do not edit `pkg/scripts/scripts_suite_test.go` or the sibling test files.\n159\t- AC12 (proving the env reaches the Claude subprocess) is operator-verified on the host after merge, against the router token and the committed Config value; it is not reproducible in this container. Do not attempt it and do not add it to `<verification>`.\n160\t- Do NOT commit — dark-factory handles git.\n161\t- Existing tests must still pass, and the healthcheck / oauth-probe routing is untouched.\n162\t\n163\t</constraints>\n164\t\n165\t<verification>\n166\t\n167\tRun each command from the repo root. Every line must pass.\n168\t\n169\t```bash\n170\tmake test          # the consistency test runs here\n171\tmake precommit     # AC1 — must exit 0\n172\t```\n173\t\n174\t**AC7 — env forwarding (all four must pass):**\n175\t\n176\t```bash\n177\ttest \"$(grep -cE '^[[:space:]]+CLAUDE_ENV: \"GIT_REST_URL=http://vault-obsidian-personal:9090,PROMETHEUS_URL=http://prometheus.monitoring:9090\"$' k8s/defect-diagnoser-agent-config.yaml)\" = \"1\"\n178\ttest \"$(grep -cE 'CLAUDE_ENV: .*GIT_REST_URL=http://vault-obsidian-personal:9090' k8s/defect-diagnoser-agent-config.yaml)\" = \"1\"\n179\ttest \"$(grep -cE 'CLAUDE_ENV: .*PROMETHEUS_URL=http://prometheus.monitoring:9090' k8s/defect-diagnoser-agent-config.yaml)\" = \"1\"\n180\t! grep -qE '^[[:space:]]+(GIT_REST_URL|PROMETHEUS_URL):' k8s/defect-diagnoser-agent-config.yaml\n181\t```\n182\t\n183\t**AC8 — allowlist, scripts and prose agree:**\n184\t\n185\t```bash\n186\t# `-F` because the allowlist contains `(`, `)` and `*`, which plain grep reads as BRE metacharacters\n187\ttest \"$(grep -cF 'ALLOWED_TOOLS: \"Read,Grep,Glob,Bash(scripts/vault-read.sh:*),Bash(scripts/vault-list.sh:*),Bash(scripts/prometheus-query.sh:*),Bash(scripts/repo-clone.sh:*)\"' k8s/defect-diagnoser-agent-config.yaml)\" = \"1\"\n188\t! grep -qiE 'pod[- ]?logs' k8s/defect-diagnoser-agent-config.yaml agent/.claude/CLAUDE.md README.md pkg/prompts/*.md\n189\t```\n190\t\n191\t**AC11 — image, hygiene and docs:**\n192\t\n193\t```bash\n194\tgrep -qE 'apk .*add.* git( |$)' Dockerfile\n195\ttest \"$(grep -c '^/agent/repos/' .gitignore)\" = \"1\"\n196\ttest \"$(grep -c 'docs/observation-scripts.md' README.md)\" -ge 1\n197\ttest \"$(grep -cE 'CLAUDE_ENV.*(GIT_REST_URL|PROMETHEUS_URL)' README.md)\" -ge 1\n198\ttest \"$(grep -c 'task files → Prometheus' README.md)\" = \"1\"\n199\ttest \"$(grep -c 'Kubernetes API reads, deferred — see NEXT-DIRECTIONS v2' k8s/defect-diagnoser-agent-config.yaml)\" -ge 1\n200\ttest \"$(grep -c 'Kubernetes API reads, deferred — see NEXT-DIRECTIONS v2' README.md)\" -ge 1\n201\t! grep -q 'ClaudeRunnerConfig.Env' README.md\n202\ttest \"$(sed -n '/^### Claude subprocess env allowlist/,/^## /p' README.md | grep -c 'CLAUDE_ENV')\" -ge 1\n203\ttest \"$(grep -c '(task files, Prometheus)' agent/.claude/CLAUDE.md)\" = \"1\"\n204\ttest \"$(sed -n '/^## Unreleased/,/^## v/p' CHANGELOG.md | grep -ci 'observation scripts')\" -ge 1\n205\t```\n206\t\n207\t</verification>\n208\t"}]},"parent_tool_use_id":"chatcmpl-tool-8184a1f4e4436900","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"7b870b6d-682b-43f2-af4a-5003fd2344e0","timestamp":"2026-09-27T23:31:28.434Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8c3a2e406179738c","type":"tool_result","content":"1\t---\n2\tstatus: draft\n3\tspec: [002-diagnose-observed-defect-with-verdict-gate]\n4\tcreated: \"2026-09-28T01:40:00Z\"\n5\tbranch: dark-factory/diagnose-observed-defect-with-verdict-gate\n6\t---\n7\t\n8\t# Wire the diagnoser: dispatch, phase chain, README mapping and changelog\n9\t\n10\t<summary>\n11\t\n12\t- A `defect-diagnose` task finally routes to the diagnoser instead of being rejected as an unknown task type.\n13\t- The old generic `llm` task type is no longer accepted, so a task can no longer reach a prompt that says nothing about diagnosis.\n14\t- The liveness task types keep routing to the liveness agent, unchanged.\n15\t- The three phases run one after another in a single job, each wrapped by the binary checks that decide whether its output stands.\n16\t- The local command-line path builds exactly the same diagnoser as the in-cluster path, so a local run proves the deployed behaviour.\n17\t- An end-to-end test drives the whole chain with a fake model and asserts the task file that comes out, for ten different outcomes including a happy path, a low-confidence escalation, a stale failure marker and a forged heading.\n18\t- The README documents the operator-supplied service-to-repo mapping and links the rule set the binary enforces.\n19\t- The changelog records the change.\n20\t\n21\t</summary>\n22\t\n23\t<objective>\n24\t\n25\tJoin the two halves this spec built. The verdict gate and the line guard exist as agent steps after prompt 1; the three per-phase prompts exist after prompt 2; nothing routes a `defect-diagnose` task to any of it. This prompt changes the dispatch table so `defect-diagnose` reaches the diagnoser and `llm` no longer does, extends the runner seam so the factory can build the gate against the clone root, wraps each phase step with its binary checks, proves the whole chain end to end with a fake model, and documents the operator-supplied mapping the diagnoser depends on.\n26\t\n27\t</objective>\n28\t\n29\t<context>\n30\t\n31\tRead these before writing anything:\n32\t\n33\t- `specs/in-progress/002-diagnose-observed-defect-with-verdict-gate.md` — read `## Desired Behavior` 1 and `## Acceptance Criteria` AC2, AC3 and AC9. AC3's ten cases (a)–(j) are the test matrix this prompt must implement.\n34\t- `docs/verdict-gate.md` — the authoritative rule set. You need § The verdict block (the eight fields, in order, and the template), § Service → repo mapping input (the `service_repo.<service>` form the README must document), and § Model-output heading rule.\n35\t- `pkg/verdict/` — **prompt 1's deliverable**. Read `step.go`, `gate.go` and `lineguard.go` before wiring anything. If the package is missing, see the sentinel rule in `<requirements>`.\n36\t- `pkg/prompts/` — **prompt 2's deliverable**. `prompts.BuildInstructions(phase)` and the three `*.md` files must already exist. If they do not, see the sentinel rule in `<requirements>`.\n37\t- `pkg/factory/factory.go` — the file you change. Read all of it: `CreateClaudeRunner`, `CreateAgent`, `CreateAgentFromRunner`, `CreateAgentProvider`, `serviceName`.\n38\t- `pkg/factory/factory_test.go`, `pkg/factory/factory_suite_test.go`, `pkg/factory/factory_kafka_topic_test.go` — the existing specs. `factory_test.go`'s dispatch specs assert the accepted-types list `[healthcheck llm oauth-probe]` and that `TaskTypeLLM` returns the domain agent; both change here.\n39\t- `cmd/run-task/main.go` — the local-CLI entry point. It calls `factory.CreateAgent(claudeConfigDir, agentDir, allowedTools, model, claudeEnv, envContext)` and then `agent.Run(ctx, a.Phase, string(taskContent), deliverer)`. **Read it; do not edit it.** Its call must keep compiling unchanged.\n40\t- `main.go` — the Kafka entry point. It calls `provider.Get(ctx, agentlib.TaskType(a.TaskType))`. **Read it; do not edit it.**\n41\t- `README.md` — where the mapping section goes. Read the existing `### Config CRD env pattern` and `### Claude subprocess env allowlist` sections; add to them rather than restructuring the file.\n42\t- `CHANGELOG.md` — the file to append an `## Unreleased` section to.\n43\t- `scenarios/001-diagnose-one-observed-defect.md` — already updated alongside this spec (its Setup carries a `service_repo.` entry and its Step 1 writes the task file with `defect_id`). **Do not edit it**; AC9 only checks it.\n44\t- `agent/.claude/CLAUDE.md` — the guardrails prose. Do not edit it.\n45\t- `docs/dod.md` — the Definition of Done for this repo.\n46\t- `/home/node/.claude/CLAUDE.md` — the container's execution rules.\n47\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-testing-guide.md` — Ginkgo/Gomega suite and `DescribeTable` conventions.\n48\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-factory-pattern.md` — `Create*` prefix, zero business logic in a factory, constructor shape.\n49\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-error-wrapping-guide.md` — `github.com/bborbe/errors`; never `fmt.Errorf`.\n50\t- `/home/node/.claude/plugins/marketplaces/coding/docs/go-precommit.md` — linter limits that apply to test files too (`funlen` 80 lines / 50 statements, `gocognit` 20, `nestif` 4, golines max-len 100, `dupl`).\n51\t- `/home/node/.claude/plugins/marketplaces/coding/docs/changelog-guide.md` — entry format and the required `feat:` / `fix:` prefix.\n52\t\n53\t**Verified facts about the current code, read while writing this prompt:**\n54\t\n55\t- `pkg/factory/factory.go` declares `const serviceName = \"defect-diagnoser-agent\"` and these exported constructors: `CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, env)`; `CreateSyncProducer(ctx, brokers)`; `CreateKafkaResultDeliverer(...)`; `CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer`; `CreateAgent(claudeConfigDir, agentDir, allowedTools, model, claudeEnv, envContext) *agentlib.Agent`; `CreateAgentFromRunner(runner, envContext) *agentlib.Agent`; `CreateAgentProvider(claudeConfigDir, agentDir, allowedTools, model, claudeEnv, envContext) agentlib.AgentProvider`.\n56\t- `CreateAgentFromRunner` is the seam `CreateAgent` delegates to; `CreateAgentProvider` also calls it once and reuses the same `runner` for the liveness agent. There are exactly **two** call sites of `CreateAgentFromRunner` in the repo, both inside `factory.go`. Grep for `CreateAgentFromRunner` and for `factory.CreateAgent` before you start, and confirm that list has not grown.\n57\t- `agentlib.NewAgentProvider(name string, agents map[TaskType]*Agent) AgentProvider`; `Get` returns `errors.Errorf(ctx, \"unknown task_type %q for %s; accepted: %v\", …)` on a map miss, with the accepted keys sorted. `agentlib.TaskType` values are validated by `TaskType.Validate(ctx)` against `^[a-z0-9-]+$` and a 63-character limit.\n58\t- `github.com/bborbe/agent` exports `TaskTypeLLM = \"llm\"`, `TaskTypeHealthcheck = \"healthcheck\"` and the deprecated alias `TaskTypeOAuthProbe = \"oauth-probe\"`. It does **not** export a `defect-diagnose` constant, so this prompt defines one locally in `pkg/factory`.\n59\t- `healthcheck.NewAgent(step agentlib.Step) *agentlib.Agent` and `healthcheck.NewClaudeStep(runner claudelib.ClaudeRunner) agentlib.Step` are unchanged and stay in use. The liveness step's prompt is the literal `reply 'ok'`.\n60\t- `delivery.NewFileResultDeliverer(generator delivery.ContentGenerator, filePath string) agentlib.ResultDeliverer` and `factory.CreateFileResultDeliverer(filePath string)` both exist; the latter wires `delivery.NewPassthroughContentGenerator()`. `delivery.NewPassthroughContentGenerator()` applies `status` / `phase` frontmatter and splices the `## Failure` section from `result.Message` on `failed` / `needs_input`.\n61\t- The counterfeiter fake is importable as `agentmocks \"github.com/bborbe/agent/mocks\"` and offers `RunReturns(result *claude.ClaudeResult, err error)`, `RunReturnsOnCall(i int, result *claude.ClaudeResult, err error)`, `RunCallCount() int`, `RunArgsForCall(i int) (context.Context, string)`. Call index `i` is zero-based.\n62\t- `claudelib.AgentDir` is a string type used as the Claude runner's working directory. With a fake runner it is only read by the factory, so a test can pass a `t.TempDir()`.\n63\t\n64\t**AC10 (the rung-1 live run) is the spec's operator-executable rung.** It needs two port-forwards, the router token and a real dev service, so it cannot run inside this container. Do not attempt it and do not add it to `<verification>`.\n65\t\n66\t\n67\t<!-- Open questions for the reviewer — decisions taken here, each with the alternative:\n68\t\n69\t     1. `CreateAgentFromRunner` gains a third parameter (`agentDir`) even though AC2 only\n70\t        says the seam \"takes the runner\". The gate and the line guard need the clone root\n71\t        (`<agent dir>/repos`), and nothing else on the seam can supply it: the\n72\t        `claude.ClaudeRunner` interface exposes only `Run`, so the runner's working\n73\t        directory is not readable from outside. Both call sites are inside `factory.go` and\n74\t        are updated here; `CreateAgent`'s own signature — the one `cmd/run-task/main.go`\n75\t        calls — is unchanged, and `factory_test.go`'s `CreateAgent` spec keeps compiling.\n76\t\n77\t     2. AC3 is implemented as ten specs in `pkg/factory/phase_chain_test.go` driving the\n78\t        real provider and the real `CreateFileResultDeliverer`, rather than as more step\n79\t        tests. AC3 asserts \"the written task\", which only the real content generator\n80\t        produces (it is what applies `status` / `phase` and splices `## Failure`); the\n81\t        step-level tables live in prompt 1.\n82\t\n83\t     3. AC3(b)(d)(e)(f) assert \"the fake runner captured exactly two prompts\". That is\n84\t        implemented with `RunCallCount()` on the counterfeiter fake.\n85\t\n86\t     4. The task fixture sets `trigger_count: 1` and `max_triggers: 3`. Without a count\n87\t        below the cap, the framework's `failed` path clears the assignee at cap exhaustion\n88\t        and case (e) — which asserts the assignee is KEPT on `failed` — would fail for the\n89\t        wrong reason.\n90\t\n91\t     5. The new tests construct `service_repo.<service>` keys in their own local\n92\t        `envContext`. That is the only way to exercise gate rules h and i, and it is\n93\t        simulated operator input rather than committed mapping data — consistent with the\n94\t        spec's Non-goal and with AC9's `grep -rn 'service_repo\\.' k8s/` returning 0 lines.\n95\t        Reviewer: confirm the Non-goal is not meant to forbid these test fixtures; if it\n96\t        is, rules h and i become untestable and the Non-goal needs amending.\n97\t\n98\t     6. The README change is a new `### Service → repo mapping` subsection under\n99\t        `### Config CRD env pattern`. AC9 only greps for `service_repo.` and\n100\t        `docs/verdict-gate.md` anywhere in `README.md`, so the placement is a readability\n101\t        choice, not a pinned one.\n102\t\n103\t     7. AC2's liveness assertion is implemented by running the liveness agent with the same\n104\t        fake runner and asserting the captured prompt contains none of\n105\t        `scripts/repo-clone.sh`, `scripts/vault-read.sh`, `scripts/prometheus-query.sh`\n106\t        and `## Verdict`.\n107\t\n108\t     8. Removing `llm` changes `pkg/factory/factory_test.go`'s accepted-types assertion to\n109\t        the literal `[defect-diagnose healthcheck oauth-probe]` (the sorted order of the\n110\t        new map's keys). Spec 002's constraint that \"all other existing tests keep passing\"\n111\t        is read as excluding these dispatch specs, which cannot survive the Non-goal that\n112\t        drops `llm`. -->\n113\t\n114\t</context>\n115\t\n116\t<requirements>\n117\t\n118\t0. **Fail-loud sentinels for the cross-prompt boundary.** Before writing anything, confirm `pkg/verdict/gate.go`, `pkg/verdict/step.go`, `pkg/verdict/lineguard.go`, `pkg/prompts/planning.md`, `pkg/prompts/execution.md` and `pkg/prompts/ai_review.md` all exist and that `prompts.BuildInstructions` takes a phase argument. If `pkg/verdict/` is missing or does not export the names below, stop and report `\"status\":\"failed\"` with the message `verdict gate not yet deployed (prompt 1 of spec 002)`. If the per-phase prompts or the phase-taking `BuildInstructions` are missing, stop and report `\"status\":\"failed\"` with the message `per-phase prompts not yet deployed (prompt 2 of spec 002)`. Never report `needs_input` for either — a missing prerequisite is a broken ship order, not a question for the operator.\n119\t\n120\t   The names you depend on from `pkg/verdict`, all exported: `NewGate(envContext map[string]string, cloneRoot string) *Gate`; `(*Gate).Evaluate(ctx, md) Decision`; `(*Gate).Review(ctx, md) Decision`; `type Decision struct { Status agentlib.AgentStatus; Message string }`; `NewPlanningStep(inner agentlib.Step) agentlib.Step`; `NewExecutionStep(inner agentlib.Step, gate *Gate) agentlib.Step`; `NewAIReviewStep(inner agentlib.Step, gate *Gate) agentlib.Step`.\n121\t\n122\t1. **Extend the runner seam.** Change `CreateAgentFromRunner` to\n123\t\n124\t   ```go\n125\t   func CreateAgentFromRunner(\n126\t       runner claudelib.ClaudeRunner,\n127\t       agentDir claudelib.AgentDir,\n128\t       envContext map[string]string,\n129\t   ) *agentlib.Agent\n130\t   ```\n131\t\n132\t   and wrap each phase step prompt 2 built with its binary checks:\n133\t\n134\t   - build the gate once: `gate := verdict.NewGate(envContext, filepath.Join(string(agentDir), \"repos\"))`. The clone root is exactly where `scripts/repo-clone.sh` writes — the fixed `repos/` directory beside `scripts/`, i.e. `<agent dir>/repos`. Use `path/filepath`, not string concatenation.\n135\t   - planning: `verdict.NewPlanningStep(planningStep)`.\n136\t   - execution: `verdict.NewExecutionStep(executionStep, gate)`.\n137\t   - ai_review: `verdict.NewAIReviewStep(aiReviewStep, gate)`.\n138\t   - register the wrapped steps under `domain.TaskPhasePlanning`, `domain.TaskPhaseExecution` and `domain.TaskPhaseAIReview`, in that order, and keep the three `claude.AgentStepConfig` values prompt 2 set (`OutputSection` `## Plan` / `## Verdict` / `## Review`, `NextPhase` `execution` / `ai_review` / `done`, and `EnvContext: envContext` on all three).\n139\t   - the body stays free of business logic: no conditional, no loop, no error path. It is composition only.\n140\t\n141\t2. **Keep `CreateAgent` delegating to the seam.** `CreateAgent`'s own signature does not change — `cmd/run-task/main.go` calls it unchanged. Its body must still be exactly a call to `CreateAgentFromRunner`, now passing `agentDir` through:\n142\t\n143\t   ```go\n144\t   return CreateAgentFromRunner(\n145\t       CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv),\n146\t       agentDir,\n147\t       envContext,\n148\t   )\n149\t   ```\n150\t\n151\t   `grep -n 'CreateAgentFromRunner' pkg/factory/factory.go` must show `CreateAgent` calling it.\n152\t\n153\t3. **Dispatch.** Add the local task-type constant next to `serviceName`:\n154\t\n155\t   ```go\n156\t   // TaskTypeDefectDiagnose is the work task type this binary exists to serve:\n157\t   // stage 1 of the defect lane. It is not exported by github.com/bborbe/agent,\n158\t   // so it is declared here.\n159\t   const TaskTypeDefectDiagnose agentlib.TaskType = \"defect-diagnose\"\n160\t   ```\n161\t\n162\t   Then change `CreateAgentProvider` to build the diagnoser through the seam and to drop `llm` from the table:\n163\t\n164\t   ```go\n165\t   runner := CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv)\n166\t   diagnoser := CreateAgentFromRunner(runner, agentDir, envContext)\n167\t   livenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(runner))\n168\t   return agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n169\t       TaskTypeDefectDiagnose:       diagnoser,\n170\t       agentlib.TaskTypeHealthcheck: livenessAgent,\n171\t       agentlib.TaskTypeOAuthProbe:  livenessAgent,\n172\t   })\n173\t   ```\n174\t\n175\t   The map has exactly three entries. `agentlib.TaskTypeLLM` must not appear anywhere in `pkg/factory/`. `healthcheck` and `oauth-probe` keep returning the same liveness agent instance. The liveness agent's prompt must contain none of the diagnoser's instructions — it is built from `healthcheck.NewClaudeStep`, not from `prompts.BuildInstructions`.\n176\t\n177\t4. **Update the existing dispatch specs** in `pkg/factory/factory_test.go` so they describe the new table. The three that change are the ones asserting `TaskTypeLLM` returns the domain agent and the two asserting the accepted-types list. `Get(TaskTypeDefectDiagnose)` replaces `Get(agentlib.TaskTypeLLM)`; the accepted-types assertion becomes the literal `[defect-diagnose healthcheck oauth-probe]` (that is the sorted order of the new map's keys). Keep the assertions on the quoted offending value and on the binary name. Add one spec asserting `agentlib.TaskTypeLLM` now misses with `unknown task_type`. Leave `factory_kafka_topic_test.go` and every other spec in the file untouched.\n178\t\n179\t5. **Prove the diagnoser is reachable, with a fake runner** — add `pkg/factory/diagnoser_dispatch_test.go`, `package factory_test`, using the existing `pkg/factory/factory_suite_test.go`:\n180\t\n181\t   - `Get(ctx, factory.TaskTypeDefectDiagnose)` returns a non-nil agent. Run it at `domain.TaskPhasePlanning` against a minimal task document and a `factory.CreateFileResultDeliverer(<temp file>)`, with an `agentmocks.ClaudeRunner` that records the prompt; assert the captured prompt contains `scripts/repo-clone.sh`. The prompt is `RunArgsForCall(0)`'s second argument.\n182\t   - `Get(ctx, agentlib.TaskTypeHealthcheck)` and `Get(ctx, agentlib.TaskTypeOAuthProbe)` each return the liveness agent; run it with the same fake runner and assert the captured prompt contains none of `scripts/repo-clone.sh`, `scripts/vault-read.sh`, `scripts/prometheus-query.sh` and `## Verdict`.\n183\t   - `Get(ctx, agentlib.TaskTypeLLM)` returns an error whose message contains `unknown task_type`.\n184\t   - a boundary check for the new constant: `Expect(factory.TaskTypeDefectDiagnose.Validate(ctx)).To(Succeed())`, so a future rename that breaks the `^[a-z0-9-]+$` contract fails here rather than at deploy.\n185\t\n186\t   Build the provider with a temp directory as the agent dir, so nothing the test does touches `agent/repos/`.\n187\t\n188\t6. **Wired phase-chain tests** — add `pkg/factory/phase_chain_test.go`, `package factory_test`. This is AC3. Every case drives the **real** provider and the **real** file deliverer, and asserts on the task file that `factory.CreateFileResultDeliverer` wrote.\n189\t\n190\t   **Harness.** One helper builds, for a case: a temp directory used as both the agent dir and the clone root (`<tmp>/repos/<owner>/<repo>/<path>`), the `envContext` mapping `{\"service_repo.<service>\": \"<owner>/<repo>\"}`, a task file written to a second temp path, the `agentmocks.ClaudeRunner` with one `RunReturnsOnCall` per model step, the provider from `factory.CreateAgentProvider`, and the agent from `provider.Get(ctx, factory.TaskTypeDefectDiagnose)`. The runner is then driven with `agent.Run(ctx, domain.TaskPhasePlanning, taskContent, factory.CreateFileResultDeliverer(taskPath))` and the resulting file is read back.\n191\t\n192\t   Set the fake's default `RunReturns` to a benign `{\"status\":\"failed\",\"message\":\"unexpected extra model call\"}` envelope as well as the per-call stubs, so an extra model call fails the case with a readable message instead of panicking on a nil result.\n193\t\n194\t   The base task document for every case except (j) is a file whose frontmatter carries `task_type: defect-diagnose`, `phase: planning`, `status: in_progress`, `assignee: defect-diagnoser-agent`, `defect_id: defect-1`, `trigger_count: 1`, `max_triggers: 3`, and whose body carries `## Observation` naming the mapped service, with **no** `## Plan`. The `trigger_count` below `max_triggers` matters for the `failed` cases: at the cap the framework clears the assignee, which would hide the retry-versus-escalate assertion.\n195\t\n196\t   Assert on the written file's content, not on a copy: frontmatter fields (`status`, `phase`, `assignee`), the presence and order of `## Plan`, `## Verdict`, `## Review`, the absence of `## Verdict`, the absence of `## Failure`, `## Failure` message substrings, and `grep -c '^## Verdict'` / `grep -c '^## Review'` counts. Factor the reading and the counting into helpers so no `It` body is a copy of another — `dupl` analyses test files.\n197\t\n198\t   **The ten cases.** Implement each as its own spec (a `DescribeTable` over a case struct is fine, as long as each row asserts the whole list below).\n199\t\n200\t   - **(a) Happy path.** The fake runner returns, in order: a plan, then a `High` verdict that passes every gate rule and whose cited line exists in the fixture clone, then a passing review. The input task carries a stale `## Failure` from a prior attempt, placed **after** `## Observation`. The written task ends `status: completed`, `phase: done`, contains `## Plan`, `## Verdict` and `## Review` in that order, and has no `## Failure`.\n201\t   - **(b) Medium verdict.** The verdict is valid with `confidence: Medium` and its cited line exists in the fixture clone. The written task has `assignee: \"\"`, `phase: execution`, and a `## Failure` containing `below High`. `## Verdict` is present and `## Review` is absent — ai_review never ran. Assert the fake runner captured exactly two prompts, the second containing `scripts/prometheus-query.sh`.\n202\t   - **(c) Missing line.** The verdict is `High` but its cited line exceeds the fixture file's length; the review passes. The written task has `assignee: \"\"`, a `## Failure` containing `beyond end of file`, the fixture file's line count, and `evidence:` followed by each line of the fixture's evidence prefixed `> `. It has `phase: ai_review`, **no** `## Verdict`, and is not `status: completed`.\n203\t   - **(d) `defect_id` mismatch.** The verdict's `defect_id` differs from the frontmatter's. The written task has `assignee: \"\"`, `phase: execution`, and **no** `## Verdict` — the removal happens on the task's parsed sections, so assert on the written file and on the fake runner capturing exactly two prompts.\n204\t   - **(e) Malformed verdict (rule a).** The execution response contains no yaml block. The written task has `phase: execution`, the assignee kept (`defect-diagnoser-agent`), a `## Failure`, and **no** `## Verdict`. This is the `failed` path, so the assignee must survive.\n205\t   - **(f) Model escalates at execution.** The second fake response is `{\"status\":\"needs_input\",\"message\":\"…\"}`. The written task has `phase: execution` and `assignee: \"\"`. This pins the phase cursor on entry, not only in the gate's reject branches.\n206\t   - **(g) Heading rule, planning.** The planning response contains a column-0 `## Verdict` line. The result is `failed` naming `## Plan`; the fake runner captured exactly one prompt; the written task has `phase: planning`, no `## Plan` section, and `grep -c '^## Verdict'` equal to 0. The `## Failure` body has no line starting with `#`.\n207\t   - **(h) Heading rule, execution.** The execution response carries a valid verdict block plus a column-0 `## Verdict` line. The result is `failed` naming `## Verdict`, and the written task has `phase: execution` and `grep -c '^## Verdict'` equal to 0.\n208\t   - **(i) Heading rule, ai_review.** The review response contains a column-0 `## Verdict` line. The result is `failed` naming `## Review`, and the written task has `phase: ai_review`, no `## Review`, and exactly one `^## Verdict` line — the gated verdict execution wrote.\n209\t   - **(j) Entry at ai_review.** The task enters at `phase: ai_review` with a pre-written, otherwise valid `confidence: Medium` verdict whose line exists in the fixture clone, and the fake runner returns a passing review. The written task is not `status: completed`: it has `assignee: \"\"`, `phase: ai_review`, and a `## Failure` containing `below High`.\n210\t\n211\t   **Fixtures.** The fixture clone is a temp directory holding `<repo>/<path>` with a known number of lines, so cases (a), (b), (j) pass the line guard and case (c) fails it. The fixture verdict is the eight keys in the contract's order with `evidence` naming `scripts/prometheus-query.sh` and quoting an output line. Give the fake runner's plan response a `## Plan`-shaped body naming `service`, `repo`, `clone_path` and `head_sha`, and its review response a body with no column-0 `#` line. Keep every fixture string in a shared helper so the cases differ only in the field each one changes.\n212\t\n213\t   For the review response to be \"passing\" it only has to be a `done` envelope whose body has no column-0 `#` line — the binary checks the review's shape, not its prose.\n214\t\n215\t7. **README — document the mapping input.** Add a `### Service → repo mapping` subsection under `### Config CRD env pattern`, before `### Claude subprocess env allowlist`. It must:\n216\t\n217\t   - explain that the diagnoser owns no mapping data, and that the operator supplies one entry per service through the existing `ENV_CONTEXT` channel, in the form `service_repo.<service>=<owner>/<repo>`, comma-separated when there is more than one;\n218\t   - state that the mapping renders into the prompt's `## Environment` section as `service_repo.<service>: <owner>/<repo>`, and that a service resolves **only** on an exact, case-sensitive key match — no fuzzy match, no fallback, and no repo from the model's own knowledge;\n219\t   - say that the mapping is deliberately **not** committed to this repo's `k8s/` Config, and that an unmapped service escalates to the operator instead of guessing;\n220\t   - link the rule set the binary enforces: a line containing the literal `docs/verdict-gate.md`.\n221\t\n222\t   `grep -c 'service_repo\\.' README.md` must be at least 1 and `grep -c 'docs/verdict-gate.md' README.md` must be at least 1. Leave the rest of the README's structure alone — in particular do not re-add any mention of pod logs or events, and do not touch the generic `Tune ALLOWED_TOOLS per task shape` table.\n223\t\n224\t8. **CHANGELOG.** Add an `## Unreleased` section above `## v0.0.0` with exactly one bullet describing what was implemented. Follow `changelog-guide.md`: the bullet needs a `feat:` prefix and must mention the diagnoser. Do not describe verification steps, do not list files, and do not use a prompt filename as the entry. This prompt owns the only `## Unreleased` entry for this spec — the sibling prompts deliberately add none.\n225\t\n226\t9. **AC9 checks that need no edit, only confirmation.** `scenarios/001-diagnose-one-observed-defect.md` was already updated alongside this spec. Do not edit it. Confirm with the `<verification>` greps that its Setup block still carries a `service_repo.` entry and its Step 1 block still carries `defect_id`.\n227\t\n228\t10. **Self-check before finishing.** Re-run `<verification>` and confirm every line passes. Then walk AC2, AC3 and AC9 bullet by bullet against your change and confirm each is actually asserted — a case that asserts only the status and not the written task does not count. Confirm `cmd/run-task/main.go` and `main.go` still compile unchanged, and that the two `CreateAgentFromRunner` call sites are both updated.\n229\t\n230\t</requirements>\n231\t\n232\t<constraints>\n233\t\n234\t- **Contract** ([[Defect Lane Task Chain]], amended 2026-09-27; copied into `docs/verdict-gate.md` because the container cannot read the vault). Fixed: the `## Verdict` field names and their order; the `confidence` values `High | Medium | Low`; and the escalation split (no line → no Verdict; line + Medium/Low → Verdict kept; stage 2 only from High). `## Observation` is read and never rewritten.\n235\t- **Gate rules are frozen in `docs/verdict-gate.md`.** Do not change that page, and do not change the rule behaviour prompt 1 shipped.\n236\t- **Frozen envelope:** the final-response JSON `{status, message, files}` that the delivery layer parses is unchanged.\n237\t- **Escalation mechanics are the framework's.** `needs_input` clears `assignee`, sets `previous_assignee` and writes `## Failure`. `failed` keeps the assignee for the trigger-count retry, and clears it only at cap exhaustion. Do not reimplement any of it.\n238\t- **Phase cursor.** The diagnoser writes no frontmatter field of its own except `phase`. Prompt 1's step wrappers already set it on entry; do not add a second writer.\n239\t- `healthcheck` / `oauth-probe` routing and the liveness agent are unchanged, and they share the one `runner` instance.\n240\t- **Do NOT add a confidence-threshold knob and do NOT add a gate opt-out flag.** `High`-only is the contract; the spec's Non-goals forbid both outright.\n241\t- **No committed mapping data.** No `service_repo.<service>` key/value pair may be hard-coded in the Config, in non-test Go code, or in any docs file. The README documents the **form** only. The new tests are the one exception and the reason the exception exists: they construct `service_repo.<service>` keys in their own local `envContext` to exercise rules h and i, which cannot be tested without them — that is simulated operator input, not committed mapping data.\n242\t- **Do NOT add a `pod-logs.sh` or any pod-log / event read**, and do not re-introduce a pod-log mention into the README. That waits on the Config CRD gaining a service-account field and is an explicit spec Non-goal.\n243\t- Do NOT change the `github.com/bborbe/agent` module or its version. No `go get`, no version bump, and never `-mod=vendor`.\n244\t- **Scope.** This prompt touches `pkg/factory/factory.go`, `pkg/factory/factory_test.go`, the two new `pkg/factory/*_test.go` files, `README.md` and `CHANGELOG.md`. Do NOT edit `pkg/verdict/`, `pkg/prompts/`, `main.go`, `cmd/run-task/main.go`, `k8s/`, `agent/`, `scenarios/`, `docs/verdict-gate.md` or `docs/observation-scripts.md`.\n245\t- **Prompts 1 and 2 of this spec must have landed first.** If `pkg/verdict/` or the per-phase prompts are missing, follow requirement 0 — report `\"status\":\"failed\"` naming the missing prompt. Never `needs_input`.\n246\t- Do NOT create or edit the four read-only scripts. They are spec `read-only-observation-toolkit`'s deliverable, and **that spec must be merged before this one starts**.\n247\t- Do NOT commit — dark-factory handles git.\n248\t- Existing tests must still pass. The only specs this prompt changes are the three dispatch assertions in `pkg/factory/factory_test.go`; everything else stays green.\n249\t\n250\t</constraints>\n251\t\n252\t<verification>\n253\t\n254\tRun every line from the repo root. All must pass.\n255\t\n256\t```bash\n257\tmake test          # the new dispatch and phase-chain suites run here\n258\tmake precommit     # AC1 — must exit 0\n259\t\n260\t# AC2 — the seam exists and CreateAgent delegates to it\n261\tgrep -n 'CreateAgentFromRunner' pkg/factory/factory.go\n262\ttest \"$(grep -c 'CreateAgentFromRunner(' pkg/factory/factory.go)\" -ge 3\n263\t\n264\t# the dispatch table has the new task type and no longer accepts llm\n265\tgrep -qF 'TaskTypeDefectDiagnose:' pkg/factory/factory.go\n266\tgrep -qE 'agentlib\\.TaskTypeHealthcheck: +livenessAgent' pkg/factory/factory.go\n267\tgrep -qE 'agentlib\\.TaskTypeOAuthProbe: +livenessAgent' pkg/factory/factory.go\n268\t! grep -q 'agentlib.TaskTypeLLM' pkg/factory/\n269\t\n270\t# AC9 — README documents the mapping form and links the rule set\n271\ttest \"$(grep -c 'service_repo\\.' README.md)\" -ge 1\n272\ttest \"$(grep -c 'docs/verdict-gate.md' README.md)\" -ge 1\n273\t\n274\t# AC9 — no mapping entry is committed to the Config\n275\t! grep -rq 'service_repo\\.' k8s/\n276\t\n277\t# AC9 — scenario 001 already carries both edits; this prompt only confirms them\n278\ttest \"$(sed -n '/^1\\. \\*\\*Create the task/,/^2\\. /p' scenarios/001-diagnose-one-observed-defect.md | grep -c defect_id)\" -ge 1\n279\ttest \"$(sed -n '/^\\*\\*Setup\\*\\*/,/^\\*\\*Acceptance\\*\\*/p' scenarios/001-diagnose-one-observed-defect.md | grep -c 'service_repo\\.')\" -ge 1\n280\t\n281\t# AC9 — the changelog records the change, and the README keeps no pod-log claim\n282\ttest \"$(sed -n '/^## Unreleased/,/^## v/p' CHANGELOG.md | grep -ci 'diagnos')\" -ge 1\n283\ttest \"$(grep -ciE 'pod[- ]?logs' README.md)\" = \"0\"\n284\t\n285\t# the factory tests leave no clone behind and never touch the shared local one\n286\ttest -z \"$(find agent/repos -mindepth 1 2>/dev/null)\"\n287\t! grep -rn 'agent/repos' pkg/factory/\n288\t\n289\t# changed code reaches at least 80% statement coverage\n290\tgo test -mod=mod -coverprofile=/tmp/factory-cover.out ./pkg/factory/...\n291\ttest \"$(go tool cover -func=/tmp/factory-cover.out | tail -1 | sed -E 's/.* ([0-9]+)\\.[0-9]+%/\\1/')\" -ge 80\n292\t```\n293\t\n294\t</verification>\n295\t"}]},"parent_tool_use_id":"chatcmpl-tool-8184a1f4e4436900","session_id":"d0a8f161-dbd4-4f10-88f7-931e909fc308","uuid":"57729ee4-d206-4c52-9054-bb74b04b55c7","timestamp":"2026-09-27T23:31:28.467Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2"}
